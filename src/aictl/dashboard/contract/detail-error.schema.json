{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/detail-error.schema.json",
  "title": "DetailError",
  "type": "object",
  "properties": {
    "key": {"type": "string"},
    "node_scope": {"$ref": "node-scope.schema.json"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {"type": "number"},
          "detail": {"type": "string"},
          "agent_id": {"type": "string"},
          "title": {"type": "string"}
        },
        "required": ["ts", "detail", "agent_id", "title"]
      }
    }
  },
  "required": ["key", "items"]
}
