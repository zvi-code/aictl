{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/terminal-resource-process.schema.json",
  "title": "TerminalResourceProcess",
  "type": "object",
  "properties": {
    "pid": {"type": "integer"},
    "tool": {"type": "string"},
    "name": {"type": "string"},
    "cmdline": {"type": "string"},
