{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/flow-summary.schema.json",
  "title": "FlowSummary",
  "type": "object",
  "properties": {
    "total_input_tokens": {"type": "integer"},
    "total_output_tokens": {"type": "integer"},
    "total_cache_tokens": {"type": "integer"},
    "total_cache_creation_tokens": {"type": "integer"},
    "total_cost_usd": {"type": ["number", "null"]},
    "priced_calls": {"type": "integer"},
    "total_steps": {"type": "integer"},
    "total_tokens": {"type": "integer"},
    "avg_tokens_per_call": {"type": ["number", "null"]},
    "duration_s": {"type": "number"},
    "source": {"type": "string"},
    "total_turns": {"type": "integer"},
    "total_api_calls": {"type": "integer"},
    "total_tool_uses": {"type": "integer"},
    "compactions": {"type": "integer"},
    "errors": {"type": "integer"},
    "subagents": {"type": "integer"},
    "event_count": {"type": "integer"},
    "cumulative_tokens": {"type": "integer"},
    "largest_turn_tokens": {"type": "integer"},
    "ttft_calls": {"type": "integer"},
    "ttft_ms": {"type": ["number", "null"]},
    "hooks": {"type": "integer"},
    "shown_events": {"type": "integer"},
    "omitted_events": {"type": "integer"},
    "offset": {"type": "integer"},
    "matched_events": {"type": "integer"},
    "at_offset": {"type": ["integer", "null"], "description": "With at: the position of the model call at that time, else of the first event at or after it; the flow has read older segments down to it."},
    "first_offset": {"type": "integer", "description": "Position of the oldest event read so far. Positions count from where the flow's first read started, so older events have negative positions."},
    "older_events": {"type": "boolean", "description": "Older events exist that are not read yet; a window before first_offset reads them."},
    "complete": {"type": "boolean", "description": "Every event of the range is read, and the totals cover the whole range."},
    "flow_epoch": {"type": "string", "description": "Changes when the server reads the flow again from its newest events; positions of another epoch do not fit."},
    "turn_marks": {"type": "array", "items": {"$ref": "turn-mark.schema.json"}}
  },
  "required": [
    "total_input_tokens",
    "total_output_tokens",
    "total_cache_tokens",
    "total_tokens",
    "avg_tokens_per_call",
    "duration_s",
    "source",
    "total_turns",
    "total_api_calls",
    "total_tool_uses",
    "compactions",
    "errors",
    "subagents",
    "event_count"
  ]
}
