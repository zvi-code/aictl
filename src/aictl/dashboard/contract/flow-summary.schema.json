{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/flow-summary.schema.json",
  "title": "FlowSummary",
  "type": "object",
  "properties": {
    "total_input_tokens": {"type": "integer"},
    "total_output_tokens": {"type": "integer"},
    "total_cache_tokens": {"type": "integer"},
    "total_tokens": {"type": "integer"},
    "avg_tokens_per_call": {"type": ["number", "null"]},
    "duration_s": {"type": "number"},
    "source": {"type": "string"},
    "total_turns": {"type": "integer"},
    "total_api_calls": {"type": "integer"},
    "total_tool_uses": {"type": "integer"},
    "compactions": {"type": "integer"},
    "errors": {"type": "integer"},
    "subagents": {"type": "integer"},
    "event_count": {"type": "integer"},
    "cumulative_tokens": {"type": "integer"},
    "largest_turn_tokens": {"type": "integer"},
    "ttft_calls": {"type": "integer"},
    "ttft_ms": {"type": ["number", "null"]},
    "hooks": {"type": "integer"},
    "shown_events": {"type": "integer"},
    "omitted_events": {"type": "integer"},
    "offset": {"type": "integer"},
    "matched_events": {"type": "integer"},
    "turn_marks": {"type": "array", "items": {"$ref": "turn-mark.schema.json"}}
  },
  "required": [
    "total_input_tokens",
    "total_output_tokens",
    "total_cache_tokens",
    "total_tokens",
    "avg_tokens_per_call",
    "duration_s",
    "source",
    "total_turns",
    "total_api_calls",
    "total_tool_uses",
    "compactions",
    "errors",
    "subagents",
    "event_count"
  ]
}
