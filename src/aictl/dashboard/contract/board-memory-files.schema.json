{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/board-memory-files.schema.json",
  "title": "BoardMemoryFiles",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "path": {"type": "string"},
      "declared_for": {"type": ["string", "null"]},
      "project": {"type": "string"},
      "loaded_sessions": {"type": "integer"},
      "loaded_by": {"type": ["array", "null"], "items": {"type": "string"}},
      "loaded_ts": {"type": ["number", "null"]},
      "modified_ts": {"type": ["number", "null"]},
      "scanned_ts": {"type": ["number", "null"]},
      "category": {"type": "string"},
      "scope": {"type": "string"},
      "tokens": {"type": ["integer", "null"]},
      "lines_added": {"type": ["integer", "null"]},
      "lines_removed": {"type": ["integer", "null"]},
      "changed_by": {"type": ["string", "null"]},
      "changed_ts": {"type": ["number", "null"]},
      "node_id": {"type": "string"}
    },
    "required": [
      "path",
      "declared_for",
      "scope",
      "tokens",
      "lines_added",
      "lines_removed",
      "changed_by",
      "changed_ts"
    ]
