{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/detail-context.schema.json",
  "title": "DetailContext",
  "oneOf": [
    {"$ref": "context-local.schema.json"},
    {
      "type": "object",
      "properties": {
        "generated_at": {"type": "number"},
        "node_scope": {"$ref": "node-scope.schema.json"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"node_id": {"type": "string"}},
            "required": ["node_id"],
            "allOf": [{"$ref": "context-local.schema.json"}]
          }
        }
      },
      "required": ["generated_at", "nodes"]
    }
  ]
}
