{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/board-sources.schema.json",
  "title": "BoardSources",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "tool": {"type": "string"},
      "label": {"type": "string"},
      "data_from": {"type": ["string", "null"]},
      "last_data_ts": {"type": ["number", "null"]},
      "locations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {"path": {"type": "string"}, "found_by": {"type": "string"}},
          "required": ["path", "found_by"]
        }
      }
    },
    "required": ["tool", "label", "data_from", "last_data_ts", "locations"]
  }
}
