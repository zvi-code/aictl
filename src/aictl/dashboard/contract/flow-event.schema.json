{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/flow-event.schema.json",
  "title": "FlowEvent",
  "type": "object",
  "properties": {
    "type": {"type": "string"},
    "ts": {"type": "number"},
    "source": {"type": "string"},
    "rt_tokens": {"type": ["integer", "null"]},
    "cum_tokens": {"type": ["integer", "null"]},
    "turn_index": {"type": ["integer", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "parent_agent_id": {"type": ["string", "null"]},
    "agent_name": {"type": ["string", "null"]},
    "api_calls": {"type": "integer"},
    "confirm": {"type": ["string", "null"]},
    "compaction_count": {"type": ["integer", "null"]},
    "before_tokens": {"type": ["integer", "null"]},
    "after_tokens": {"type": ["integer", "null"]},
    "context_tokens": {"type": ["integer", "null"]},
    "completed": {"type": ["boolean", "null"]},
    "cost_usd": {"type": ["number", "null"]},
    "duration_ms": {"type": ["number", "null"]},
    "end_ts": {"type": ["number", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "finish_reason": {"type": ["string", "null"]},
    "from": {"type": ["string", "null"]},
    "input_preview": {"type": ["string", "null"]},
    "is_error": {"type": "boolean"},
    "error_type": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "hook_name": {"type": ["string", "null"]},
    "hook_input": {"type": ["string", "null"]},
    "hook_output": {"type": ["string", "null"]},
    "message": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "name": {"type": ["string", "null"]},
    "params": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "preview": {"type": ["string", "null"]},
    "prompt": {"type": ["string", "null"]},
    "prompt_length": {"type": "integer"},
    "redacted": {"type": "boolean"},
    "result_summary": {"type": ["string", "null"]},
    "result_size": {"type": ["integer", "null"]},
    "result_preview": {"type": ["string", "null"]},
    "reported_spans": {"type": ["integer", "null"]},
    "request_preview": {"type": ["string", "null"]},
    "response": {"type": ["string", "null"]},
    "response_preview": {"type": ["string", "null"]},
    "subtype": {"type": ["string", "null"]},
    "decision": {"type": ["string", "null"]},
    "cwd": {"type": ["string", "null"]},
    "step_key": {"type": ["string", "null"]},
    "success": {"type": ["boolean", "null"]},
    "target": {"type": ["string", "null"]},
    "text_status": {"type": ["string", "null"]},
    "to": {"type": ["string", "null"]},
    "tokens": {"$ref": "usage-tokens.schema.json"},
    "ttft_ms": {"type": ["number", "null"]},
    "turn_id": {"type": ["string", "null"]},
    "round_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "message_id": {"type": ["string", "null"]},
    "tool_call_id": {"type": ["string", "null"]},
    "span_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "wall_ms": {"type": ["number", "null"]},
    "step": {"type": "integer", "description": "Step number in the flow scope: a model round with its tool calls and reply, or one other event."},
    "request_n": {"type": "integer", "description": "Number of this model request in the flow scope, from 1."},
    "http_status": {"type": ["integer", "null"]},
    "request_bytes": {"type": ["integer", "null"], "description": "Size of the model request body in bytes, when the source reports it."},
    "thinking_chars": {"type": ["integer", "null"]},
    "reasoning_tokens": {"type": ["integer", "null"]},
    "input_bytes": {"type": ["integer", "null"], "description": "UTF-8 size of the arguments sent to the tool."},
    "output_bytes": {"type": ["integer", "null"], "description": "UTF-8 size of the result returned by the tool."},
    "result_tokens_est": {"type": ["integer", "null"], "description": "Estimated tokens of the tool result from its size (bytes / 4); an estimate, not a count."},
    "confirm_wait_ms": {"type": ["number", "null"]},
    "outcome": {"type": "string", "description": "How a subagent ended: completed, failed, or not reported."},
    "spawned_agent_id": {"type": "string", "description": "The subagent a tool call started."},
    "spawned_by_ts": {"type": "number", "description": "Time of the tool call that started this subagent."}
  },
  "required": ["type", "ts", "source", "rt_tokens", "cum_tokens"]
}
