{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/detail-board-history.schema.json",
  "title": "DetailBoardHistory",
  "description": "Board history for a named node or fleet. A whole-window chart read returns only the scope, range and series.",
  "type": "object",
  "properties": {
    "node_scope": {"$ref": "board-node-scope.schema.json"},
    "range": {"$ref": "board-range.schema.json"},
    "series": {"$ref": "board-series.schema.json"},
    "generated_at": {"$ref": "board-generated-at.schema.json"},
    "agents": {"$ref": "board-agents.schema.json"},
    "attention": {"$ref": "board-attention.schema.json"},
    "by_model": {"$ref": "board-by-model.schema.json"},
    "by_role": {"$ref": "board-by-role.schema.json"},
    "capture_mode": {"$ref": "board-capture-mode.schema.json"},
    "changes": {"$ref": "board-changes.schema.json"},
    "confirms": {"$ref": "board-confirms.schema.json"},
    "coverage": {"$ref": "board-coverage.schema.json"},
    "credits": {"$ref": "board-credits.schema.json"},
    "errors": {"$ref": "board-errors.schema.json"},
    "kpis": {"$ref": "board-kpis.schema.json"},
    "latency": {"$ref": "board-latency.schema.json"},
    "loops": {"$ref": "board-loops.schema.json"},
    "memory_files": {"$ref": "board-memory-files.schema.json"},
    "options": {"$ref": "board-options.schema.json"},
    "project_prompts": {"$ref": "board-project-prompts.schema.json"},
    "project_prompts_searched": {"$ref": "board-project-prompts-searched.schema.json"},
    "projects": {"$ref": "board-projects.schema.json"},
    "prompts": {"$ref": "board-prompts.schema.json"},
    "prompts_total": {"$ref": "board-prompts-total.schema.json"},
    "saved_usd": {"$ref": "board-saved-usd.schema.json"},
    "scope": {"$ref": "board-scope.schema.json"},
    "skills": {"$ref": "board-skills.schema.json"},
    "sources": {"$ref": "board-sources.schema.json"},
    "tests": {"$ref": "board-tests.schema.json"},
    "tests_piped": {"$ref": "board-tests-piped.schema.json"},
    "tool_labels": {"$ref": "board-tool-labels.schema.json"},
    "tools": {"$ref": "board-tools.schema.json"},
    "unpriced": {"$ref": "board-unpriced.schema.json"},
    "field_errors": {
      "type": "object",
      "description": "Board fields an optional section could not read, each with the reason. The fields named are absent; a dotted name is one key of a field.",
      "additionalProperties": {"type": "string"}
    }
  },
  "required": ["node_scope", "range", "series"],
  "additionalProperties": false
}
