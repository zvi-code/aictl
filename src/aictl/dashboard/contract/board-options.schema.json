{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/board-options.schema.json",
  "title": "BoardOptions",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "agents": {"type": "integer"}
        },
        "required": ["id", "label", "agents"]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"id": {"type": "string"}, "agents": {"type": "integer"}},
        "required": ["id", "agents"]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"id": {"type": "string"}, "agents": {"type": "integer"}},
        "required": ["id", "agents"]
      }
    }
  },
  "required": ["tools", "projects", "models"]
}
