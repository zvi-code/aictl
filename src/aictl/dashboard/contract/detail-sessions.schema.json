{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/detail-sessions.schema.json",
  "title": "DetailSessions",
  "type": "object",
  "properties": {
    "total": {"type": "integer"},
    "unfiltered": {"type": "integer"},
    "node_scope": {"$ref": "node-scope.schema.json"},
    "facets": {
      "type": "object",
      "properties": {
        "sessions": {"type": "integer"},
        "running": {"type": "integer"},
        "ended": {"type": "integer"},
        "inferred": {"type": "integer"},
        "importing": {"type": "integer"},
        "not_imported": {"type": "integer"}
      },
      "required": ["sessions", "running", "ended", "inferred", "importing", "not_imported"]
    },
    "without": {
      "type": "object",
      "properties": {
        "status": {"type": "integer"},
        "model": {"type": "integer"},
        "name_source": {"type": "integer"},
        "errors": {"type": "integer"},
        "min_tokens": {"type": "integer"},
        "min_cost": {"type": "integer"}
      },
      "required": ["status", "model", "name_source", "errors", "min_tokens", "min_cost"]
    },
    "query": {
      "type": "object",
      "properties": {
        "q": {"type": "string"},
        "tools": {"type": ["array", "null"], "items": {"type": "string"}},
        "since": {"type": ["number", "null"]},
        "until": {"type": ["number", "null"]},
        "project": {"type": "string"},
        "model": {"type": "string"},
        "status": {"type": "string"},
        "name_source": {"type": "string"},
        "errors": {"type": "boolean"},
        "min_tokens": {"type": "integer"},
        "min_cost": {"type": "number"},
        "sort": {"type": "string"},
        "order": {"enum": ["asc", "desc"]},
        "limit": {"type": "integer"},
        "offset": {"type": "integer"}
      },
      "required": ["q", "tools", "since", "until", "project", "model", "status", "name_source", "errors",
        "min_tokens", "min_cost", "sort", "order", "limit", "offset"]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "title_source": {"type": "string"},
          "project": {"type": "string"},
          "tool": {"type": "string"},
          "model": {"type": "string"},
          "started_at": {"type": ["number", "null"]},
          "ended_at": {"type": ["number", "null"]},
          "last_activity_at": {"type": ["number", "null"]},
          "duration": {"type": ["number", "null"]},
          "status": {"enum": ["running", "waiting", "looping", "idle", "unknown", "ended", "failed", "inferred", "not_imported"]},
          "status_basis": {"type": "string"},
          "status_evidence": {"type": "string"},
          "end_reason": {"type": "string"},
          "pids": {"type": "array", "items": {"type": "integer"}},
          "import_state": {"enum": ["complete", "reading", "partial", "waiting", "none"]},
          "import_evidence": {"type": "string"},
          "import": {
            "type": ["object", "null"],
            "properties": {
              "files": {"type": "integer"},
              "complete": {"type": "integer"},
              "reading": {"type": "integer"},
              "waiting": {"type": "integer"},
              "outside_window": {"type": "integer"},
              "size_bytes": {"type": ["integer", "null"]},
              "bytes_read": {"type": ["integer", "null"]},
              "modified_at": {"type": ["number", "null"]},
              "source_file": {"type": "string"}
            },
            "required": ["files", "complete", "reading", "waiting", "outside_window", "size_bytes", "bytes_read",
              "modified_at", "source_file"]
          },
          "openable": {"type": "boolean"},
          "closed_reason": {"type": ["string", "null"]},
          "artifacts": {"type": ["integer", "null"]},
          "commits": {"type": ["integer", "null"]},
          "cost_usd": {"type": ["number", "null"]},
          "prompts": {"type": ["integer", "null"]},
          "errors": {"type": ["integer", "null"]},
          "tokens": {"type": ["integer", "null"]},
          "tool_calls": {"type": ["integer", "null"]},
          "match": {"type": "string"},
          "match_text": {"type": "string"},
          "node_id": {"type": "string"},
          "session_id": {"type": "string"}
        },
        "required": [
          "id",
          "title",
          "title_source",
          "project",
          "tool",
          "model",
          "started_at",
          "ended_at",
          "last_activity_at",
          "duration",
          "status",
          "status_evidence",
          "end_reason",
          "pids",
          "import_state",
          "import_evidence",
          "import",
          "openable",
          "closed_reason",
          "artifacts",
          "commits",
          "cost_usd",
          "prompts",
          "errors",
          "tokens",
          "tool_calls",
          "match",
          "match_text"
        ]
      }
    },
    "by_node": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"node_id": {"type": "string"}, "sessions": {"type": "integer"}},
        "required": ["node_id", "sessions"]
      }
    }
  },
  "required": ["total", "rows", "facets", "without", "unfiltered", "query"]
}
