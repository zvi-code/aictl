  "required": [
    "id",
    "short",
    "title",
    "parent_id",
    "role",
    "status",
    "tool",
    "project",
    "models",
    "input",
    "output",
    "cache_read",
    "cache_write",
    "cached_share",
    "cost_usd",
    "tool_calls",
    "failures",
    "confirms_asked",
    "confirms_denied",
    "started_at",
    "ended_at",
    "activity",
