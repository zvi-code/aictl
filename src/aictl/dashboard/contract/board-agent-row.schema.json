    "parent_id": {"type": ["string", "null"]},
    "role": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "tool": {"type": "string"},
    "project": {"type": "string"},
    "models": {"type": "array", "items": {"type": "string"}},
    "primary_model": {"type": ["string", "null"]},
    "input": {"type": ["integer", "null"]},
    "output": {"type": ["integer", "null"]},
    "cache_read": {"type": ["integer", "null"]},
    "cache_write": {"type": ["integer", "null"]},
    "cached_share": {"type": ["number", "null"]},
    "cost_usd": {"type": ["number", "null"]},
    "tool_calls": {"type": ["integer", "null"]},
    "failures": {"type": ["integer", "null"]},
    "confirms_asked": {"type": ["integer", "null"]},
    "confirms_denied": {"type": ["integer", "null"]},
    "started_at": {"type": ["number", "null"]},
    "ended_at": {"type": ["number", "null"]},
    "activity": {"type": "array", "items": {"type": "integer"}},
    "placeholder": {"type": "boolean"},
    "status_evidence": {"type": ["string", "null"]},
    "end_reason": {"type": "string"},
    "node_id": {"type": "string"},
    "native_id": {"type": "string"},
    "session_id": {"type": "string"},
