    "commands": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {"type": ["object", "array", "string", "number", "boolean", "null"]}
        },
        {"type": "null"}
      ]
    },
    "ingestion_capacity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {"type": ["object", "array", "string", "number", "boolean", "null"]}
        },
        {"type": "null"}
      ]
    },
    "ingestion_details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {"type": ["object", "array", "string", "number", "boolean", "null"]}
        },
        {"type": "null"}
      ]
    },
    "ingestion_traffic": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {"type": ["object", "array", "string", "number", "boolean", "null"]}
        },
        {"type": "null"}
      ]
    },
    "traffic_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "tables": {"type": "array", "items": {"type": "string"}},
          "ingestion_modes": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": ["integer", "null"]},
          "rows_per_s": {"type": ["number", "null"]},
          "bytes": {"type": ["integer", "null"]},
          "bytes_per_s": {"type": ["number", "null"]},
          "rate_per_s": {"type": ["number", "null"]},
          "failed": {"type": ["integer", "null"]},
          "requests": {"type": ["integer", "null"]},
          "pending": {"type": ["integer", "null"]},
