{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/health-store.schema.json",
  "title": "HealthStore",
  "type": "object",
  "properties": {
    "kind": {"type": ["string", "null"]},
    "destination": {"type": ["string", "null"]},
    "cluster_url": {"type": ["string", "null"]},
    "database": {"type": ["string", "null"]},
    "ingestion_mode": {"type": ["string", "null"]},
    "measurement_scope": {"type": ["string", "null"]},
    "counter_scope": {"type": ["string", "null"]},
    "commands_scope": {"type": ["string", "null"]},
    "capacity_scope": {"type": ["string", "null"]},
    "write_volume_scope": {"type": ["string", "null"]},
    "storage_budget_bytes": {"type": ["integer", "null"]},
    "queued_history_rows_unconfirmed": {"type": ["integer", "null"]},
    "table_inventory": {"anyOf": [{"$ref": "table-inventory.schema.json"}, {"type": "null"}]},
