        "required": [
          "id",
          "label",
          "tables",
          "ingestion_modes",
          "rows",
          "rows_per_s",
          "bytes",
          "bytes_per_s",
          "rate_per_s",
          "failed",
          "requests",
          "pending",
          "measurement_scope"
