    },
    "otel_sink": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {"type": ["object", "array", "string", "number", "boolean", "null"]}
        },
        {"type": "null"}
      ]
    },
    "health": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {"type": "string"},
            "scope": {"type": "string"},
            "checked_at": {"type": ["number", "null"]},
            "last_error": {"type": ["string", "null"]},
            "last_success_at": {"type": ["number", "null"]}
          }
        },
        {"type": "null"}
      ]
    }
