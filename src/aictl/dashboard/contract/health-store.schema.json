              "rows_dropped": {"type": "integer"},
              "lost_at_exit": {"type": "integer"},
              "last_error": {"type": ["string", "null"]},
              "ingest_requests": {"type": "integer"},
              "ingest_failures": {"type": "integer"},
              "bytes_sent": {"type": "integer"},
              "last_sent_at": {"type": ["number", "null"]},
              "last_error_at": {"type": ["number", "null"]}
