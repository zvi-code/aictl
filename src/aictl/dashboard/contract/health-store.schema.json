            "required": [
              "mode", "queue_depth", "queue_bytes", "in_flight", "rows_sent", "rows_dropped",
              "lost_at_exit", "last_error", "ingest_requests", "ingest_failures", "bytes_sent",
              "last_sent_at", "last_error_at"
