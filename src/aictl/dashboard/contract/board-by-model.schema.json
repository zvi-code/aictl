{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/board-by-model.schema.json",
  "title": "BoardByModel",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "model": {"type": "string"},
      "reported_as": {
        "description": "The stored spellings of this canonical model id, each with the tools that reported it.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {"id": {"type": "string"}, "tools": {"type": "array", "items": {"type": "string"}}},
          "required": ["id", "tools"]
        }
      },
      "agents": {"type": "integer"},
      "msgs": {"type": "integer"},
      "tokens": {"type": "integer"},
      "input": {"type": ["integer", "null"]},
      "output": {"type": ["integer", "null"]},
      "cache_read": {"type": ["integer", "null"]},
      "cache_write": {"type": ["integer", "null"]},
      "cached_share": {"type": ["number", "null"]},
      "cost_usd": {"type": ["number", "null"]},
      "p95_ms": {"type": ["number", "null"]},
      "agent_ids": {"type": "array", "items": {"type": "string"}}
    },
    "required": [
      "model",
      "agents",
      "msgs",
      "tokens",
      "input",
      "output",
      "cache_read",
      "cache_write",
      "cached_share",
      "cost_usd",
      "p95_ms",
      "agent_ids"
    ]
  }
}
