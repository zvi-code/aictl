{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aictl.invalid/contract/v1/board-changes.schema.json",
  "title": "BoardChanges",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "project": {"type": "string"},
          "lines_added": {"type": ["integer", "null"]},
          "lines_removed": {"type": ["integer", "null"]},
          "edits": {"type": "integer"},
          "agents": {"type": "integer"},
          "last_ts": {"type": "number"},
          "node_id": {"type": "string"},
          "record": {"type": "string"}
        },
        "required": ["path", "project", "lines_added", "lines_removed", "edits", "agents", "last_ts"]
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "files": {"type": "integer"},
        "lines_added": {"type": ["integer", "null"]},
        "lines_removed": {"type": ["integer", "null"]},
        "edits": {"type": "integer"}
      },
      "required": ["files", "lines_added", "lines_removed", "edits"]
    }
  },
  "required": ["files", "totals"]
}
