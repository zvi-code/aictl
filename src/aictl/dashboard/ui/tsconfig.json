{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    // Solid 2.0 RC ships the JSX types in its separate DOM renderer package.
    "paths": {
      "solid-js/jsx-runtime": ["./node_modules/@solidjs/web/types/jsx.d.ts"],
      "solid-js/jsx-dev-runtime": ["./node_modules/@solidjs/web/types/jsx.d.ts"]
    },
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test"]
}
