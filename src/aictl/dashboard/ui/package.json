{
  "name": "aictl-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "lint": "eslint src test",
    "gen:contract": "node scripts/gen-contract.mjs",
    "test": "tsc --noEmit && vitest run",
    "build:ui-test": "vite build --outDir node_modules/.cache/aictl-ui-baseline --emptyOutDir",
    "test:ui": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.21",
    "@tanstack/table-core": "^9.3.1",
    "@tanstack/virtual-core": "^3.19.11",
    "dockview-core": "^8.9.0",
    "lucide": "^1.72.0",
    "solid-js": "2.0.0-rc.21",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "axe-core": "^4.11.3",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.19.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "npm:@solidjs/vite-plugin@3.0.0-next.57",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@solidjs/compiler": "2.0.0-rc.21"
  }
