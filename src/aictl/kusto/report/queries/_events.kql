// Shared by the convergence sections. R: the current requests of the window. T: the current tool calls.
// The store keeps no link from a tool call to the request that issued it. So both go on one time line per
// context (a session plus one agent), and a call belongs to the latest request before it; seq numbers the requests.
let EditTools = dynamic(["Edit", "Write", "MultiEdit", "NotebookEdit", "apply_patch", "create", "edit", "str_replace_editor", "create_file", "replace_string_in_file", "multi_replace_string_in_file", "insert_edit_into_file"]);
let ReadTools = dynamic(["Read", "view", "read_file"]);
let RepeatWindow = 20;  // a call is a repeat when the same call ran in the same context within this many requests before it
let R = materialize(report_requests
  | project id, ts, session_id, agent_id, stream = strcat(session_id, "|", agent_id), tool, model, cost_usd, output_tokens,
            ctx = input_tokens + cache_read_tokens + cache_creation_tokens);
let T = materialize(report_tool_calls
  | extend inp = parse_json(input), is_edit = tool_name in (EditTools), is_read = tool_name in (ReadTools)
  | extend file = iff(is_edit or is_read, coalesce(extract(@"\*\*\* (?:Update|Add|Delete) File: ([^\r\n]+)", 1, tostring(inp.input)), tostring(inp.filePath), tostring(inp.file_path), tostring(inp.path), target), "")
  | project id, ts, session_id, stream = strcat(session_id, "|", agent_id), tool, tool_name, target, file, is_edit, is_read,
            failed = is_error == 1 or exit_code > 0, sig = hash(strcat(tool_name, "|", iff(isnotempty(target), target, input))), output_bytes, duration_ms);
let E = materialize(union (R | project stream, ts, is_req = 1, rid = id), (T | project stream, ts, is_req = 0, cid = id)
  | order by stream asc, ts asc, is_req desc
  | extend seq = row_cumsum(is_req, stream != prev(stream)));
// every tool call with the number of its request; rep: the same call ran shortly before; fail_rep: and both failed
let TC = materialize(T | join kind = inner (E | where is_req == 0 | project cid, seq) on $left.id == $right.cid
  | project-away cid
  | order by stream asc, sig asc, ts asc
  | extend again = stream == prev(stream) and sig == prev(sig) and seq - prev(seq) <= RepeatWindow
  | extend rep = again, fail_rep = again and failed and prev(failed));
let RQ = materialize(R | join kind = inner (E | where is_req == 1 | project rid, seq) on $left.id == $right.rid | project-away rid);
