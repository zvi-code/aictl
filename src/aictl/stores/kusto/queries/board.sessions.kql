declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', session_keys:dynamic, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let sessions_secs = sessions | extend started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s;
sessions_secs
| where all_nodes or node_id == requested_node
| where strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
| summarize arg_max(_v, *) by ['project'], node_id, session_id
| where not(coalesce(column_ifexists('_deleted', false), false))
| summarize arg_max(_v, *) by node_id, session_id
| order by node_id asc, session_id asc
| take row_limit
| project node_id, session_id, tool, project_path, model, pid, started_at, ended_at, last_activity_at, end_reason,
    ['title'], title_source
