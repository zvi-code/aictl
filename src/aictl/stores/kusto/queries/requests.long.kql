declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, grid:long,
    requested_session:string = '', session_keys:dynamic = dynamic([]), requested_models:dynamic, min_tokens:long,
    after_row:string = '', row_limit:long
);
let cursor_row = parse_json(after_row);
requests
| where all_nodes or node_id == requested_node
| extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
| summarize arg_max(_v, *) by ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false))
| where ts between (since .. until) and isnotempty(session_id)
| where isempty(requested_session) or session_id == requested_session
| where array_length(session_keys) == 0 or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
| where model in (requested_models) and input_tokens + cache_read_tokens + cache_creation_tokens > min_tokens
| extend g=min_of(grid - 1, tolong((ts - since) / ((until - since) / grid)))
| where isempty(after_row) or case(
    ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
    node_id != tostring(cursor_row[1]), strcmp(node_id,tostring(cursor_row[1])) > 0,
    ['project'] != tostring(cursor_row[2]), strcmp(['project'],tostring(cursor_row[2])) > 0,
    strcmp(fact_key,tostring(cursor_row[3])) > 0)
| order by ts asc, node_id asc, ['project'] asc, fact_key asc
| take row_limit
| project node_id, session_id, agent_id, model, g, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens, ts,
    _page_cursor=tostring(pack_array(ts,node_id,['project'],fact_key))
