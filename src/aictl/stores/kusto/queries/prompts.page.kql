declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real = real(null), until:real = real(null),
    session_keys:dynamic, preview:bool = false, after_row:string = '', row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// session_prompts_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let session_prompts_current_rows = session_prompts_current
    | where isnull(since) or event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where isnull(until) or event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h;
let session_prompts_crossed = session_prompts_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let session_prompts_secs = union (session_prompts_current_rows | where dedup_key !in (session_prompts_crossed)),
        (session_prompts_current_rows | where dedup_key in (session_prompts_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
let cursor_row = parse_json(after_row);
session_prompts_secs
| where all_nodes or node_id == requested_node
| extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
| summarize arg_max(_v, *) by ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false))
| where isempty(agent_id) and (isnull(since) or ts >= since) and (isnull(until) or ts <= until)
| where strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
| where isempty(after_row) or case(
    isnull(ts) != isnull(cursor_row[0]), isnull(ts),
    ts != toreal(cursor_row[0]), ts < toreal(cursor_row[0]),
    node_id != tostring(cursor_row[1]), strcmp(node_id,tostring(cursor_row[1])) > 0,
    isnull(id) != isnull(cursor_row[2]), isnotnull(id),
    id != tolong(cursor_row[2]), id > tolong(cursor_row[2]),
    fact_key != tostring(cursor_row[3]), strcmp(fact_key,tostring(cursor_row[3])) > 0,
    strcmp(['project'],tostring(cursor_row[4])) > 0)
| order by ts desc nulls last, node_id asc, id asc nulls first, fact_key asc, ['project'] asc
| take row_limit
| project node_id, id, ts, session_id, agent_id, project_path, text=iff(preview, text, ''), prompt_file,
    _page_cursor=tostring(pack_array(ts,node_id,id,fact_key,['project']))
