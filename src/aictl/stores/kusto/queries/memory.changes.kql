// The memory and instruction file changes of one session, oldest first, with who made each and the
// hashes and sizes of the content before and after (file_blobs). Pages by after_row.
declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_project:string='',
    requested_session:string, requested_agent:string='', after_row:string='', row_limit:long);
let cursor_row = parse_json(after_row);
let wanted_agent = requested_agent;
file_write_events
// session_id is carried by every tombstone, so it may filter before the versions are reduced.
| where session_id == requested_session and (all_nodes or node_id == requested_node)
    and (isempty(requested_project) or ['project'] == requested_project)
| extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
| summarize arg_max(_v, *) by ['project'],node_id,key
| where not(column_ifexists('_deleted',false))
| where isnotempty(column_ifexists('mechanism',''))
| where isempty(wanted_agent) or column_ifexists('agent_id','') == wanted_agent
| where isempty(after_row) or case(
    ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
    key != tostring(cursor_row[1]), strcmp(key,tostring(cursor_row[1])) > 0,
    node_id != tostring(cursor_row[2]), strcmp(node_id,tostring(cursor_row[2])) > 0,
    strcmp(['project'],tostring(cursor_row[3])) > 0)
| order by ts asc, key asc, node_id asc, ['project'] asc
| take row_limit
| project node_id, ts, key, path, mechanism, operation, tool, tool_name, agent_id, actor, prompt_id, turn_index,
    lines_added, lines_removed, before_hash, after_hash, before_bytes, after_bytes, before_source, after_source,
    source_event_id, source_event_kind, _page_cursor=tostring(pack_array(ts,key,node_id,['project']))
