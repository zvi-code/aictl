declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_session:string,
    since:real, until:real, after_row:string='', row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let session_loaded_files_secs = session_loaded_files | extend ts = (ts - datetime(1970-01-01)) / 1s;
let session_steps_secs = session_steps | extend ts = (ts - datetime(1970-01-01)) / 1s, estimated = tolong(estimated);
// skill_uses_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let skill_uses_current_rows = skill_uses_current
    | where event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h
    | where session_id == requested_session;
let skill_uses_crossed = skill_uses_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let skill_uses_secs = union (skill_uses_current_rows | where dedup_key !in (skill_uses_crossed)),
        (skill_uses_current_rows | where dedup_key in (skill_uses_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
let cursor_row = parse_json(after_row);
let steps = session_steps_secs
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | summarize arg_max(_v, *) by ['project'], node_id, step_key
    | where not(column_ifexists('_deleted',false)) and kind == 'skill' and ts >= since and ts < until
    | project ['project'], node_id, part='steps', ts, name, key=step_key, row_type='evidence', values=pack_array(ts,agent_id,name,phase,source,step_key,turn_id,'');
let uses = skill_uses_secs
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | summarize arg_max(_v, *) by ['project'], node_id, dedup_key
    | where not(column_ifexists('_deleted',false)) and ts >= since and ts < until
    | project ['project'], node_id, part='uses', ts, name, key=dedup_key, row_type='evidence',
        values=pack_array(ts,agent_id,name,iff(trigger=='context-load','loaded','invoked'),'skill_uses',dedup_key,'','');
let loaded = session_loaded_files_secs
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | summarize arg_max(_v, *) by ['project'], node_id, session_id, path, how
    | where not(column_ifexists('_deleted',false)) and how == 'skill' and ts >= since and ts < until
    | project ['project'], node_id, part='loaded', ts, name='', key=path, row_type='evidence', values=pack_array(ts,agent_id,'','loaded','session_loaded_files','','',path);
let reported = union isfuzzy=true
    (datatable(node_id:string,SessionId:string,TraceID:string,SpanID:string,StartTime:datetime,EndTime:datetime,names:dynamic)[]),
    (OTELTraces | project node_id, SessionId, TraceID, SpanID, StartTime, EndTime,
        names=coalesce(ReportedContext.skills,iff(isnotempty(ReportedSkillNames),split(ReportedSkillNames,'\n'),
            parse_json(tostring(TraceAttributes['github.copilot.context.skills'])))))
    | where SessionId == requested_session and (all_nodes or node_id == requested_node)
    | where isnotempty(TraceID) and isnotempty(SpanID)
    | summarize arg_max(EndTime, StartTime, names) by node_id, TraceID, SpanID
    | extend ts=(StartTime-datetime(1970-01-01))/1s
    | where ts >= since and ts < until and array_length(names)>0
    | mv-expand name=set_union(array_slice(names,0,255),dynamic([])) to typeof(string)
    | where name matches regex @"^[\w][\w.:-]{0,127}$"
    | summarize spans=count(), ts=min(ts), last_ts=max(ts) by name
    | project part='reported', ts, name, key=name, row_type='reported', values=pack_array(name,ts,last_ts,spans);
union steps, uses, loaded, reported
| where isempty(after_row) or case(
    isnull(ts) != isnull(cursor_row[0]), isnotnull(ts),
    ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
    name != tostring(cursor_row[1]), strcmp(name,tostring(cursor_row[1])) > 0,
    key != tostring(cursor_row[2]), strcmp(key,tostring(cursor_row[2])) > 0,
    part != tostring(cursor_row[3]), strcmp(part,tostring(cursor_row[3])) > 0,
    node_id != tostring(cursor_row[4]), strcmp(node_id,tostring(cursor_row[4])) > 0,
    strcmp(['project'],tostring(cursor_row[5])) > 0)
| order by ts asc nulls first, name asc, key asc, part asc, node_id asc, ['project'] asc
| take row_limit
| project row_type, values, _page_cursor=tostring(pack_array(ts,name,key,part,node_id,['project']))
