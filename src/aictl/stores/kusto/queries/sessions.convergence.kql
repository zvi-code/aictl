declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real,
    restrict_sessions:bool = false, session_keys:dynamic = dynamic([]),
    restrict_tools:bool = false, requested_tools:dynamic = dynamic([]), row_limit:long
);
// Signs that a session does not converge, one row per session with 5 or more requests in the window.
// The logic follows the convergence sections of `aictl db report` (_events.kql, stuck.kql, returns.kql):
// a tool call belongs to the latest request before it in its context (one node, session and agent),
// and a call is a repeat when the same call (tool name and target, else input) ran in the same context
// within RepeatWindow requests before it. Calls whose text is no longer retained never count as repeats.
let RepeatWindow = 20;
let EditTools = dynamic(["Edit", "Write", "MultiEdit", "NotebookEdit", "apply_patch", "create", "edit", "str_replace_editor",
    "create_file", "replace_string_in_file", "multi_replace_string_in_file", "insert_edit_into_file"]);
let wanted = (t:real, n:string, s:string, client:string) {
    t between (since .. until) and isnotempty(s)
    and (not(restrict_sessions) or strcat(strlen(n), ':', n, s) in (session_keys))
    and (not(restrict_tools) or client in (requested_tools))
};
let request_versions = requests
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key);
let request_keys = request_versions | where wanted(ts, node_id, session_id, tool) | distinct ['project'], node_id, fact_key;
let R = materialize(request_versions
    | join kind=inner request_keys on ['project'], node_id, fact_key
    | project-away ['project1'], node_id1, fact_key1
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false)) and wanted(ts, node_id, session_id, tool)
    | project node_id, session_id, agent_id, stream=strcat(node_id, '|', session_id, '|', agent_id), ts, fact_key, tool, project_path, model,
              tokens=coalesce(input_tokens, 0) + coalesce(output_tokens, 0) + coalesce(cache_read_tokens, 0) + coalesce(cache_creation_tokens, 0),
              output_tokens=coalesce(output_tokens, 0), cost_usd);
let call_versions = tool_invocations
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key);
let call_keys = call_versions | where wanted(ts, node_id, session_id, tool) | distinct ['project'], node_id, fact_key;
let C = materialize(call_versions
    | join kind=inner call_keys on ['project'], node_id, fact_key
    | project-away ['project1'], node_id1, fact_key1
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false)) and wanted(ts, node_id, session_id, tool)
    | where isnotempty(tool_name) and not(tool_name startswith_cs 'permission:')
    | project ['project'], node_id, session_id, stream=strcat(node_id, '|', session_id, '|', agent_id), ts, fact_key, tool_name,
              failed=coalesce(is_error, 0) != 0, confirm, inline_target=column_ifexists('target', ''), inline_input=column_ifexists('input', ''));
let kept = union isfuzzy=true
    (datatable(['project']:string, node_id:string, dedup_key:string, _v:datetime, input:string, target:string, _deleted:bool)[]),
    (tool_invocations_text | project ['project'], node_id, dedup_key, _v, input, target, _deleted=column_ifexists('_deleted', false))
    | where (all_nodes or node_id == requested_node) and dedup_key in (C | project fact_key)
    | summarize arg_max(_v, input, target, _deleted) by ['project'], node_id, dedup_key
    | where not(coalesce(_deleted, false))
    | project ['project'], node_id, fact_key=dedup_key, kept_input=input, kept_target=target;
let T = materialize(C
    | join kind=leftouter kept on ['project'], node_id, fact_key
    | extend target=coalesce(kept_target, inline_target), input=coalesce(kept_input, inline_input)
    | extend is_edit=tool_name in~ (EditTools),
             is_commit=tool_name matches regex @"(?i)bash|shell|terminal|powershell|exec_?command|run_?command|execute_?command"
                       and coalesce(target, input) contains "git commit"
    | extend inp=iff(is_edit, parse_json(input), dynamic(null))
    | extend file=iff(is_edit, coalesce(extract(@"\*\*\* (?:Update|Add|Delete) File: ([^\r\n]+)", 1, tostring(inp.input)),
                                         tostring(inp.filePath), tostring(inp.file_path), tostring(inp.path), target), ''),
             has_text=isnotempty(target) or isnotempty(input),
             sig=hash(strcat(tool_name, '|', iff(isnotempty(target), target, input))),
             accepted=is_edit and not(failed) and not(confirm in ('denied', 'blocked'))
    | extend label=substring(strcat(tool_name, ' ', iff(isnotempty(target), target, input)), 0, 200)
    | project node_id, session_id, stream, ts, fact_key, tool_name, failed, is_edit, is_commit, accepted, file, has_text, sig, label);
let E = materialize(union (R | project stream, ts, is_req=1, fact_key), (T | project stream, ts, is_req=0, fact_key)
    | order by stream asc, ts asc, is_req desc, fact_key asc
    | extend seq=row_cumsum(is_req, stream != prev(stream)));
// The requests of each session in time order; rn numbers them from 1 across all agents of the session.
let RQ = materialize(R
    | join kind=inner (E | where is_req == 1 | project stream, fact_key, seq) on stream, fact_key
    | project-away stream1, fact_key1
    | order by node_id asc, session_id asc, ts asc, fact_key asc
    | extend rn=row_number(1, node_id != prev(node_id) or session_id != prev(session_id)));
let TC = materialize(T
    | join kind=inner (E | where is_req == 0 | project stream, fact_key, seq) on stream, fact_key
    | project-away stream1, fact_key1
    | join kind=leftouter (RQ | project stream, seq, rn) on stream, seq
    | project-away stream1, seq1
    | extend rn=coalesce(rn, 0)
    | order by stream asc, sig asc, ts asc, fact_key asc
    | extend again=has_text and stream == prev(stream) and sig == prev(sig) and seq - prev(seq) <= RepeatWindow
    | extend retry=again and prev(failed), fail_again=again and prev(failed) and failed);
let PerRequest = TC | where rn > 0
    | summarize changed=countif(accepted or (is_commit and not(failed))) by node_id, session_id, rn;
let Dry = RQ
    | join kind=leftouter PerRequest on node_id, session_id, rn
    | extend changed=coalesce(changed, 0) > 0
    | order by node_id asc, session_id asc, rn asc
    | extend run=row_cumsum(iff(changed, 1, 0), node_id != prev(node_id) or session_id != prev(session_id))
    | summarize len=countif(not(changed)), start=minif(rn, not(changed)), stop=maxif(rn, not(changed)) by node_id, session_id, run
    | summarize arg_max(len, start, stop) by node_id, session_id
    | project node_id, session_id, longest_dry=len, dry_start=start, dry_end=stop;
let Sessions = RQ
    | summarize requests=count(), tokens=sum(tokens), output_tokens=sum(output_tokens), cost_usd=sum(cost_usd),
                first_ts=min(ts), last_ts=max(ts), tool=take_any(tool), project_path=take_any(project_path), model=take_any(model)
        by node_id, session_id
    | where requests >= 5;
let Halves = RQ
    | join kind=inner (Sessions | project node_id, session_id, requests) on node_id, session_id
    | extend late=rn > requests / 2
    | summarize tokens_late=sumif(tokens, late), out_early=avgif(output_tokens, not(late)), out_late=avgif(output_tokens, late)
        by node_id, session_id;
let Calls = TC
    | summarize calls=count(), errors=countif(failed), repeats=countif(again), retries=countif(retry), failed_retries=countif(fail_again),
                edits=countif(is_edit), accepted=countif(accepted), commits=countif(is_commit and not(failed)),
                last_change=maxif(rn, accepted or (is_commit and not(failed)))
        by node_id, session_id;
let Repeated = TC | where has_text
    | summarize n=count(), reps=countif(again), first_rn=min(rn), last_rn=max(rn), label=take_any(label) by node_id, session_id, sig
    | summarize arg_max(reps, n, first_rn, last_rn, label) by node_id, session_id
    | project node_id, session_id, top_rep=reps, top_rep_calls=n, top_rep_first=first_rn, top_rep_last=last_rn, top_rep_label=label;
let Churn = TC | where is_edit and isnotempty(file)
    | summarize edits=count() by node_id, session_id, file
    | summarize arg_max(edits, file) by node_id, session_id
    | project node_id, session_id, top_file=file, top_file_edits=edits;
let NewFiles = TC | where is_edit and isnotempty(file) and rn > 0
    | summarize first_rn=min(rn) by node_id, session_id, file
    | join kind=inner (Sessions | project node_id, session_id, requests) on node_id, session_id
    | summarize files_new=count(), files_new_late=countif(first_rn > requests / 2) by node_id, session_id;
let context_versions = context_events
    | where all_nodes or node_id == requested_node
    | where kind == 'compaction'
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key);
let context_keys = context_versions | where wanted(ts, node_id, session_id, tool) | distinct ['project'], node_id, fact_key;
let Compactions = context_versions
    | join kind=inner context_keys on ['project'], node_id, fact_key
    | extend deleted=column_ifexists('_deleted', false)
    | summarize arg_max(_v, ts, session_id, kind, deleted) by ['project'], node_id, fact_key
    | where not(coalesce(deleted, false)) and kind == 'compaction' and ts between (since .. until)
    | summarize compactions=count() by node_id, session_id;
Sessions
| lookup kind=leftouter Calls on node_id, session_id
| lookup kind=leftouter Repeated on node_id, session_id
| lookup kind=leftouter Churn on node_id, session_id
| lookup kind=leftouter Dry on node_id, session_id
| lookup kind=leftouter Halves on node_id, session_id
| lookup kind=leftouter NewFiles on node_id, session_id
| lookup kind=leftouter Compactions on node_id, session_id
| extend tail_dry=requests - coalesce(last_change, 0)
| extend rank_hint=coalesce(repeats, 0) + 2 * coalesce(retries, 0) + coalesce(top_file_edits, 0) + coalesce(longest_dry, 0) / 2
                   + 5 * coalesce(compactions, 0)
| order by rank_hint desc, tokens desc, node_id asc, session_id asc
| take row_limit
