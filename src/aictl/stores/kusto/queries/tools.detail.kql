declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real = real(null), until:real = real(null),
    requested_session:string = '', requested_agent:string = '', requested_tool_name:string = '',
    query_mode:string = 'calls', restrict_sessions:bool = false, session_keys:dynamic = dynamic([]),
    real_calls:bool = true, inclusive_end:bool = true, requested_skill:string = '',
    restrict_tools:bool = false, requested_tools:dynamic = dynamic([]), after_row:string = '', row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). Every hour is read: not every use here keeps only
// the rows of the range.
let tool_invocations_current_rows = tool_invocations_current;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let cursor_row = parse_json(after_row);
let calls = materialize(
    tool_invocations_secs
    | where all_nodes or node_id == requested_node
    | where isempty(requested_session) or session_id == requested_session
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where isempty(requested_agent) or agent_id == requested_agent
    | where isempty(requested_tool_name) or tool_name == requested_tool_name
    | where (isnull(since) or ts >= since) and (isnull(until) or iff(inclusive_end, ts <= until, ts < until))
    | where not(restrict_sessions) or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | where not(real_calls) or not(tool_name startswith_cs 'permission:')
    | where query_mode != 'errors' or is_error == 1
    | where not(restrict_tools) or tool in (requested_tools)
    | where query_mode != 'skill_reads' or tolower(tool_name) in ('read','view','read_file','readfile','view_file','open_file')
);
let retained = union isfuzzy=true
    (datatable(['project']:string, node_id:string, dedup_key:string, _v:datetime, result_summary:string, target:string, _deleted:bool)[]),
    (tool_invocations_text | project ['project'], node_id, dedup_key, _v, result_summary, target,
                                    _deleted=column_ifexists('_deleted', false))
    | where all_nodes or node_id == requested_node
    | where dedup_key in (calls | project dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, dedup_key
    | where not(coalesce(_deleted, false))
    | project ['project'], node_id, fact_key=dedup_key, retained_summary=result_summary, retained_target=target;
union
    (calls | summarize total=count()
        | where query_mode == 'calls'
        | extend row_type='count'),
    (calls | join kind=leftouter retained on ['project'], node_id, fact_key
        | extend target=coalesce(retained_target, column_ifexists('target', ''))
        | where query_mode != 'tests' or target contains 'test' or target contains 'jest' or target contains 'tox'
        | where query_mode != 'skill_reads' or replace_string(target, @'\', '/') endswith strcat('/', requested_skill, '/SKILL.md')
        | project row_type='item', ['project'], node_id, session_id, agent_id, ts, tool, tool_name, project_path, duration_ms, is_error, confirm, exit_code,
                  input_bytes=column_ifexists('input_bytes', long(null)), output_bytes=column_ifexists('output_bytes', long(null)),
                  target,
                  result_summary=coalesce(retained_summary, column_ifexists('result_summary', '')), id, fact_key)
| where isempty(after_row) or case(
    row_type != tostring(cursor_row[0]), strcmp(row_type,tostring(cursor_row[0])) > 0,
    isnull(ts) != isnull(cursor_row[1]), isnull(ts),
    ts != toreal(cursor_row[1]), ts < toreal(cursor_row[1]),
    node_id != tostring(cursor_row[2]), strcmp(node_id,tostring(cursor_row[2])) > 0,
    isnull(id) != isnull(cursor_row[3]), isnotnull(id),
    id != tolong(cursor_row[3]), id > tolong(cursor_row[3]),
    fact_key != tostring(cursor_row[4]), strcmp(fact_key,tostring(cursor_row[4])) > 0,
    strcmp(['project'],tostring(cursor_row[5])) > 0)
| order by row_type asc, ts desc nulls last, node_id asc, id asc nulls first, fact_key asc, ['project'] asc
| take row_limit
| extend _page_cursor=tostring(pack_array(row_type,ts,node_id,id,fact_key,['project']))
| project-away id, fact_key, ['project']
