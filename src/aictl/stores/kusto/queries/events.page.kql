declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    since:real = real(null), until:real = real(null), requested_tool:string = '',
    requested_kinds:dynamic = dynamic([]), requested_session:string = '', raw_session:bool = false, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let events_secs = events | extend ts = (ts - datetime(1970-01-01)) / 1s;
events_secs
| where (all_nodes or node_id == requested_node) and (isempty(requested_project) or ['project'] == requested_project)
| where (isnull(since) or ts >= since) and (isnull(until) or ts <= until)
| where (isempty(requested_tool) or tool == requested_tool) and (array_length(requested_kinds) == 0 or kind in (requested_kinds))
| summarize arg_max(_v, *) by ['project'], node_id, ts, tool, kind, seq
| where not(coalesce(column_ifexists('_deleted', false), false))
| where isempty(requested_session) or session_id == requested_session
    or (not(raw_session) and tostring(parse_json(detail).session_id) == requested_session)
| extend event_order=iff(raw_session, -seq, seq)
| order by ts desc, node_id asc, event_order asc, tool asc, kind asc, ['project'] asc
| take row_limit
| project ts, tool, kind, detail=tostring(detail), session_id, pid, seq
