declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, grid:long,
    session_keys:dynamic, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let tool_invocations_current_rows = tool_invocations_current
    | where event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
// Durations are reduced to percentiles here: a list of every duration per tool and bucket was cut at
// 20,000 values, and a 90-day bucket of a busy fleet holds more calls of one tool than that.
let calls = materialize(tool_invocations_secs
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where ts between (since .. until) and not(tool_name startswith_cs 'permission:')
    | where strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | project tool_name, g=min_of(grid - 1, tolong((ts - since) / ((until - since) / grid))), is_error, duration_ms,
              input_bytes, output_bytes);
let tool_percentiles = calls | where duration_ms > 0
    | summarize tool_pct=percentiles_array(duration_ms, 50, 95) by tool_name;
let all_percentiles = toscalar(calls | where duration_ms > 0 | summarize percentiles_array(duration_ms, 50, 95, 99));
calls
| summarize calls=count(), failures=countif(is_error != 0), max_duration=max(duration_ms),
            timed=countif(duration_ms > 0),
            input_bytes=sum(input_bytes), input_count=countif(isnotnull(input_bytes)),
            output_bytes=sum(output_bytes), output_count=countif(isnotnull(output_bytes))
        by tool_name, g
| join kind=leftouter tool_percentiles on tool_name
| project tool_name, g, calls, failures, max_duration, timed, tool_pct, all_pct=all_percentiles,
          input_bytes, input_count, output_bytes, output_count
| order by tool_name asc, g asc
| take row_limit
