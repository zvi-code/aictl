declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real = real(null), until:real = real(null),
    requested_skill:string, requested_tools:dynamic = dynamic([]), restrict_tools:bool = false,
    query_mode:string = 'detail', session_keys:dynamic = dynamic([]), after_row:string = '', row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// skill_uses_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). Every hour is read: not every use here keeps only
// the rows of the range.
let skill_uses_current_rows = skill_uses_current;
let skill_uses_crossed = skill_uses_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let skill_uses_secs = union (skill_uses_current_rows | where dedup_key !in (skill_uses_crossed)),
        (skill_uses_current_rows | where dedup_key in (skill_uses_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
let cursor_row = parse_json(after_row);
let all_uses = materialize(
    skill_uses_secs
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where name == requested_skill or name endswith strcat(':', requested_skill)
    | project ['project'], node_id, session_id, agent_id, ts, tool, project_path, trigger, fact_key
);
let selected = materialize(
    all_uses | where query_mode == 'detail'
    | where (isnull(since) or ts >= since) and (isnull(until) or ts < until)
    | where not(restrict_tools) or tool in (requested_tools)
);
union
    (all_uses | where query_mode == 'detail' | summarize total=count(), first_ts=min(ts), last_ts=max(ts),
            projects=make_set_if(project_path, isnotempty(project_path), 50)
        | where query_mode == 'detail' | extend row_type='all'),
    (selected | summarize uses=count(), agents=count_distinct(tostring(pack_array(node_id, session_id, coalesce(agent_id, session_id))))
        | where query_mode == 'detail' | extend row_type='counts'),
    (selected | extend row_type='item'),
    (all_uses | where query_mode == 'starts' and strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
        | extend row_type='item')
| where isempty(after_row) or case(
    row_type != tostring(cursor_row[0]), strcmp(row_type,tostring(cursor_row[0])) > 0,
    isnull(ts) != isnull(cursor_row[1]), isnull(ts),
    ts != toreal(cursor_row[1]), ts < toreal(cursor_row[1]),
    node_id != tostring(cursor_row[2]), strcmp(node_id,tostring(cursor_row[2])) > 0,
    fact_key != tostring(cursor_row[3]), strcmp(fact_key,tostring(cursor_row[3])) > 0,
    strcmp(['project'],tostring(cursor_row[4])) > 0)
| order by row_type asc, ts desc nulls last, node_id asc, fact_key asc, ['project'] asc
| take row_limit
| extend _page_cursor=tostring(pack_array(row_type,ts,node_id,fact_key,['project']))
| project-away fact_key, ['project']
