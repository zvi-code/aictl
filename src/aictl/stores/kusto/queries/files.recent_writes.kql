declare query_parameters(all_nodes:bool=true, requested_node:string='', since:real, until:real, row_limit:long);
file_write_events
| where all_nodes or node_id == requested_node
| extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
| summarize arg_max(_v, *) by ['project'],node_id,key
| where not(column_ifexists('_deleted',false)) and ts between (since .. until)
| order by ts desc,node_id asc,key asc
| take row_limit
| project ts, session_id, tool, tool_name, path
