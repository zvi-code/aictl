declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_session:string,
    since:real=0.0, until:real=1.0e20, after_row:string='', row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let events_secs = events | extend ts = (ts - datetime(1970-01-01)) / 1s;
// An event's whole detail with its text is a column of its own row (null while text is not kept).
let events_text_secs = events | where isnotnull(full_detail)
    | project source_key, detail = full_detail, ['project'], node_id, _v, ts = (ts - datetime(1970-01-01)) / 1s;
// requests_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let requests_current_rows = requests_current
    | where isnull(since) or event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where isnull(until) or event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h
    | where session_id == requested_session;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
// session_prompts_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let session_prompts_current_rows = session_prompts_current
    | where isnull(since) or event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where isnull(until) or event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h
    | where session_id == requested_session;
let session_prompts_crossed = session_prompts_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let session_prompts_secs = union (session_prompts_current_rows | where dedup_key !in (session_prompts_crossed)),
        (session_prompts_current_rows | where dedup_key in (session_prompts_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let tool_invocations_current_rows = tool_invocations_current
    | where isnull(since) or event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where isnull(until) or event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h
    | where session_id == requested_session;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let cursor_row = parse_json(after_row);
let calls = materialize(requests_secs
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
    | summarize arg_max(_v, *) by ['project'],node_id,key
    | where not(column_ifexists('_deleted',false)) and ts >= since and ts < until);
let ev = materialize(events_secs
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | extend key=iff(isempty(source_key),strcat(ts,':',kind,':',seq),source_key)
    | summarize arg_max(_v, *) by ['project'],node_id,key
    | where not(column_ifexists('_deleted',false)) and ts >= since and ts < until);
let texts = union isfuzzy=true
    (datatable(['project']:string,node_id:string,source_key:string,_v:datetime,detail:dynamic,_deleted:bool)[]),
    (events_text_secs | project ['project'], node_id, source_key, _v, detail, _deleted=column_ifexists('_deleted',false))
    | where (all_nodes or node_id == requested_node) and source_key in (ev | project source_key)
    | summarize arg_max(_v, *) by ['project'],node_id,source_key
    | where not(_deleted)
    | project ['project'],node_id,key=source_key,retained_detail=detail;
let signals = materialize(ev
    | join kind=leftouter texts on ['project'],node_id,key
    | extend detail=coalesce(retained_detail,detail)
    | project ['project'], node_id, ts, kind, key, detail=tostring(detail));
let source_calls = materialize(union
    (calls | where source == 'transcript' | project ts),
    (tool_invocations_secs | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
        | summarize arg_max(_v, *) by ['project'],node_id,key
        | where not(column_ifexists('_deleted',false)) and source == 'transcript' and ts >= since and ts < until | project ts),
    (session_prompts_secs | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
        | summarize arg_max(_v, *) by ['project'],node_id,key
        | where not(column_ifexists('_deleted',false)) and ts >= since and ts < until | project ts));
union
    (source_calls | summarize rows=count() | project row_type='source', values=pack_array(rows)),
    (ev | where kind startswith 'hook:' | summarize rows=count(), last_ts=max(ts)
        | project row_type='hooks', values=pack_array(rows,last_ts)),
    (signals | where kind startswith 'otel:' | project row_type='signal',['project'],node_id,ts,key,values=pack_array(ts,kind,detail)),
    (signals | where detail contains_cs '"rate_limits"'
        | order by ts desc,key asc,node_id asc,['project'] asc | take 1 | project row_type='rate',values=pack_array(ts,detail)),
    (calls | where toscalar(ev | where kind startswith 'otel:' | count) > 0
        | project row_type='call',['project'],node_id,ts,key,values=pack_array(dedup_key,ts,model,output_tokens))
| where isempty(after_row) or case(
    row_type != tostring(cursor_row[0]), strcmp(row_type,tostring(cursor_row[0])) > 0,
    isnull(ts) != isnull(cursor_row[1]), isnotnull(ts),
    ts != toreal(cursor_row[1]), ts > toreal(cursor_row[1]),
    key != tostring(cursor_row[2]), strcmp(key,tostring(cursor_row[2])) > 0,
    node_id != tostring(cursor_row[3]), strcmp(node_id,tostring(cursor_row[3])) > 0,
    strcmp(['project'],tostring(cursor_row[4])) > 0)
| order by row_type asc, ts asc nulls first, key asc, node_id asc, ['project'] asc
| take row_limit
| project row_type, values, _page_cursor=tostring(pack_array(row_type,ts,key,node_id,['project']))
