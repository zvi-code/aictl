declare query_parameters(all_nodes:bool=true, requested_node:string='', since:real=0.0, until:real=1.0e20,
    requested_paths:dynamic, row_limit:long);
// Which of the requested files a session's own record shows it loaded in the time range.
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let session_loaded_files_secs = session_loaded_files | extend ts = (ts - datetime(1970-01-01)) / 1s;
session_loaded_files_secs
| where (all_nodes or node_id == requested_node) and path in (requested_paths)
| summarize arg_max(_v, *) by ['project'], node_id, session_id, path, how
| where not(column_ifexists('_deleted', false)) and ts between (since .. until)
| summarize sessions=dcount(session_id), tools=make_set(tool, 8), last_ts=max(ts) by node_id, path
| order by node_id asc, path asc
| take row_limit
