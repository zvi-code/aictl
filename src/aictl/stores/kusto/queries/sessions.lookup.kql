declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    requested_session:string, session_fragment:string = '', row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let sessions_secs = sessions | extend started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s;
sessions_secs
| where all_nodes or node_id == requested_node
| where isempty(requested_project) or ['project'] == requested_project
| where session_id == requested_session or (isnotempty(session_fragment) and session_id contains session_fragment)
| summarize arg_max(_v, *) by ['project'], node_id, session_id
| where not(coalesce(column_ifexists('_deleted', false), false))
| extend exact = session_id == requested_session
| order by exact desc, started_at desc, node_id asc, session_id asc
| take row_limit
| project node_id, session_id, tool, model, project_path, pid, git_branch, git_commit, source, started_at, ended_at,
          request_count, tool_call_count, files_modified, input_tokens, output_tokens, cache_read_tokens,
          cache_creation_tokens, cost_usd
