declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, requested_model:string = '',
    project_path_key:string = '', fold_project:bool = false, restrict_tools:bool = false,
    requested_tools:dynamic = dynamic([]), restrict_sessions:bool = false, session_keys:dynamic = dynamic([]), row_limit:long
);
let facts = materialize(
    union (requests | extend fact_table='requests'),
          (tool_invocations | extend fact_table='tool_invocations'),
          (session_prompts | extend fact_table='session_prompts')
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by fact_table, ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where ts >= since and ts < until
    | where not(restrict_tools) or tool in (requested_tools)
    | where not(restrict_sessions) or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | where isempty(project_path_key) or
        iff(fold_project, trim_end(@'/+', replace_string(tolower(project_path), @'\', '/')), project_path) == project_path_key
    | project fact_table, ts, agent_id, tool_name, model, input_tokens, output_tokens, cache_read_tokens,
              cache_creation_tokens, cost_usd
);
union
    (facts | where fact_table == 'requests' and (isempty(requested_model) or model == requested_model)
        | summarize calls=count(), input_tokens=sum(input_tokens), output_tokens=sum(output_tokens),
                    cache_read_tokens=sum(cache_read_tokens), cache_creation_tokens=sum(cache_creation_tokens),
                    last_ts=max(ts), priced=countif(isnotnull(cost_usd)), sum_cost=sum(cost_usd) by model
        | extend row_type='model', cost_usd=iff(priced == 0, real(null), sum_cost)
        | project-away priced, sum_cost),
    (facts | summarize tool_calls=countif(fact_table == 'tool_invocations' and not(tool_name startswith_cs 'permission:')),
                       prompts=countif(fact_table == 'session_prompts' and isempty(agent_id))
        | extend row_type='counts')
| order by row_type asc, model asc
| take row_limit
