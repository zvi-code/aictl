declare query_parameters(all_nodes:bool = true, requested_node:string = '', spans:dynamic, row_limit:long);
// The requests of several loops' spans per model, in one read: each span is
// [node or '' for any node, session, agent or '' for the session's every agent, since, until], both ends included.
let bounds = materialize(
    print span=spans
    | mv-expand with_itemindex=span_index span
    | project span_index, span_node=tostring(span[0]), session_id=tostring(span[1]), span_agent=tostring(span[2]),
              since_ts=toreal(span[3]), until_ts=toreal(span[4])
);
// requests_current holds the current row of each call per hour of its time (event_hour). A call
// whose time moved across an hour has a row in each hour: only the calls with two rows are reduced to
// the newest (docs/storage-schema.md, "Read the current row").
let current_rows = requests_current
    | where all_nodes or node_id == requested_node
    | where session_id in ((bounds | project session_id));
let crossed = current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
union (current_rows | where dedup_key !in (crossed)),
    (current_rows | where dedup_key in (crossed)
        | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
| where not(coalesce(_deleted, false))
| extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error)
| join kind=inner bounds on session_id
| where (isempty(span_node) or node_id == span_node) and (isempty(span_agent) or agent_id == span_agent)
    and ts >= since_ts and ts <= until_ts
// A call stored with no cost has none that can be known: a row of its own, never priced at read time.
| extend cost_known=isnotnull(cost_usd)
| summarize calls=count(), input_tokens=sum(input_tokens), output_tokens=sum(output_tokens),
            cache_read_tokens=sum(cache_read_tokens), cache_creation_tokens=sum(cache_creation_tokens),
            last_ts=max(ts), priced=countif(isnotnull(cost_usd)), sum_cost=sum(cost_usd) by span_index, model, cost_known
| where isnotempty(model) or input_tokens + output_tokens + cache_read_tokens + cache_creation_tokens > 0
| project span_index, model, calls, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens,
          last_ts, cost_usd=iff(priced == 0, real(null), sum_cost), cost_known
| order by span_index asc, model asc, cost_known desc
| take row_limit
