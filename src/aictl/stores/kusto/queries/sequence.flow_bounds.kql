declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_session:string,
    since:real, until:real, segment_bounds:dynamic=dynamic([]), page_rows:long=1500, row_limit:long);
// One row about a session's flow, which flow_projection.py reads in time segments:
// - stamps: {segment, versions, newest} for each segment (segment_bounds holds their lower
//   bounds, ascending; the last one is open-ended). A segment whose stamp is unchanged still holds
//   the same rows, so a refresh reads again only the segments that changed.
// - page_lo, page_stamp: where the next older segment starts, below the oldest segment (or below
//   until): the start of a turn about page_rows records back, or since when fewer remain; and the
//   stamp of that page. older: whether any record lies below the oldest segment.
// - last_turn: the start of the newest turn, where the open-ended segment can be split.
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let agents_secs = agents | extend is_sidechain = tolong(is_sidechain), started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, completed = tolong(completed), observed_at = (observed_at - datetime(1970-01-01)) / 1s;
let context_events_secs = context_events | extend ts = (ts - datetime(1970-01-01)) / 1s;
let copilot_session_messages_secs = copilot_session_messages | extend ts = (ts - datetime(1970-01-01)) / 1s, ingested_at = (ingested_at - datetime(1970-01-01)) / 1s;
let cursor_session_messages_secs = cursor_session_messages | extend ts = (ts - datetime(1970-01-01)) / 1s;
let events_secs = events | extend ts = (ts - datetime(1970-01-01)) / 1s;
// requests_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). Every hour is read: not every use here keeps only
// the rows of the range.
let requests_current_rows = requests_current
    | where session_id == requested_session;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let session_digests_secs = session_digests | extend ts = (ts - datetime(1970-01-01)) / 1s;
// session_prompts_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). Every hour is read: not every use here keeps only
// the rows of the range.
let session_prompts_current_rows = session_prompts_current
    | where session_id == requested_session;
let session_prompts_crossed = session_prompts_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let session_prompts_secs = union (session_prompts_current_rows | where dedup_key !in (session_prompts_crossed)),
        (session_prompts_current_rows | where dedup_key in (session_prompts_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
// A step's text is a column of its own row (null while text is not kept).
let session_step_text_secs = session_steps | where isnotnull(['text'])
    | project step_key, session_id, ts = (ts - datetime(1970-01-01)) / 1s, ['text'], ['project'], node_id, _v;
let session_steps_secs = session_steps | extend ts = (ts - datetime(1970-01-01)) / 1s, estimated = tolong(estimated);
let sessions_secs = sessions | extend started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s;
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). Every hour is read: not every use here keeps only
// the rows of the range.
let tool_invocations_current_rows = tool_invocations_current
    | where session_id == requested_session;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let vscode_chat_messages_secs = vscode_chat_messages | extend ts = (ts - datetime(1970-01-01)) / 1s, ingested_at = (ingested_at - datetime(1970-01-01)) / 1s;
let bound_count = array_length(segment_bounds);
let before = iff(bound_count > 0, todouble(segment_bounds[0]), until);
let versions = materialize(union
    (requests_secs | project session_id,node_id,ts,_v,key=strcat('r:',iff(isempty(dedup_key),tostring(id),dedup_key))),
    (tool_invocations_secs | project session_id,node_id,ts,_v,key=strcat('t:',iff(isempty(dedup_key),tostring(id),dedup_key))),
    (session_prompts_secs | project session_id,node_id,ts,_v,key=strcat('p:',iff(isempty(dedup_key),tostring(id),dedup_key))),
    (events_secs | project session_id,node_id,ts,_v,key=strcat('e:',iff(isempty(source_key),strcat(ts,':',kind,':',seq),source_key))),
    (context_events_secs | project session_id,node_id,ts,_v,key=strcat('c:',iff(isempty(dedup_key),tostring(id),dedup_key))),
    (session_steps_secs | project session_id,node_id,ts,_v,key=strcat('s:',step_key)),
    (session_step_text_secs | project session_id,node_id,ts,_v,key=strcat('x:',step_key)),
    (session_digests_secs | project session_id,node_id,ts,_v,key=strcat('d:',agent_id,':',kind,':',tostring(seq))),
    (copilot_session_messages_secs | project session_id,node_id,ts,_v,key=strcat('m:',source_table,':',tostring(source_row_id))),
    (cursor_session_messages_secs | project session_id,node_id,ts,_v,key=strcat('u:',iff(isempty(source_key),tostring(source_row_id),source_key))),
    (vscode_chat_messages_secs | project session_id,node_id,ts,_v,key=strcat('v:',source_file,':',tostring(source_row_id))),
    (agents_secs | project session_id,node_id,ts=coalesce(ended_at,started_at),_v,key=strcat('a:',agent_id)),
    (sessions_secs | project session_id,node_id,ts=coalesce(ended_at,started_at),_v,key='session')
| where session_id == requested_session and (all_nodes or node_id == requested_node)
| where isnull(ts) or ts < until
// The session row comes with every segment read: a change to it is a change of the newest segment.
| project ts=iff(key == 'session', until, coalesce(ts, until)), _v, key=strcat(node_id,'|',key));
let stamps = versions
    | where bound_count > 0 and ts >= todouble(segment_bounds[0])
    | extend segment=array_sum(array_iff(series_less_equals(segment_bounds, repeat(ts, bound_count)), 1, 0)) - 1
    | summarize n=count(), newest=max(_v) by segment
    | order by segment asc
    | summarize stamps=make_list(bag_pack('segment', segment, 'versions', n, 'newest', tostring(newest)));
let records = versions
    | where ts >= since and ts < before
    | summarize arg_max(_v, ts) by key;
let cutoff = toscalar(records | top page_rows by ts desc | summarize iff(count() < page_rows, real(null), min(ts)));
let turn_starts = union
    (session_prompts_secs | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | where isempty(agent_id) | project ts),
    (session_steps_secs | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | where role == 'user' and kind == 'message' | project ts)
    | where ts > since and ts < before;
let turn_start = toscalar(turn_starts | where isnotnull(cutoff) and ts <= cutoff | summarize max(ts));
let page_start = iff(isnull(cutoff) or isnull(turn_start), since, turn_start);
// Without segments the page is the open-ended newest segment: its stamp covers the newest rows too.
let page_versions = toscalar(versions | where ts >= page_start and (ts < before or bound_count == 0)
    | summarize pack_array(count(), tostring(max(_v))));
let newest_turn = toscalar(union
    (session_prompts_secs | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | where isempty(agent_id) | project ts),
    (session_steps_secs | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | where role == 'user' and kind == 'message' | project ts)
    | where ts > since and ts < until | summarize max(ts));
print stamps=coalesce(toscalar(stamps), dynamic([])), page_lo=page_start, page_stamp=page_versions,
    older=toscalar(records | count) > 0, last_turn=newest_turn
| take row_limit
