declare query_parameters(all_nodes:bool = true, requested_node:string = '', row_limit:long);
// When each node began to collect: its earliest system snapshot still stored. Rows of a node from
// before this time come from files read afterwards, and may still be incomplete.
system_snapshots
| where all_nodes or node_id == requested_node
| extend deleted=column_ifexists('_deleted', false)
| summarize arg_max(_v, deleted) by node_id, ['project'], ts
| where not(coalesce(deleted, false))
| summarize first_seen=min(ts) by node_id
| order by node_id asc
| take row_limit
