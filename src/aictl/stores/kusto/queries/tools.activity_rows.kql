declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real,
    requested_session:string = '', kind_filter:string, session_keys:dynamic = dynamic([]), row_limit:long
);
let calls = materialize(
    tool_invocations
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where ts between (since .. until) and isnotempty(session_id)
    | where isempty(requested_session) or session_id == requested_session
    | where array_length(session_keys) == 0 or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | where case(
        kind_filter == 'confirms', isnotempty(confirm),
        kind_filter == 'failures', is_error == 1 and not(tool_name startswith_cs 'permission:'),
        kind_filter == 'loops', not(tool_name startswith_cs 'permission:'),
        kind_filter == 'tests')
);
let text_rows = union isfuzzy=true
    (datatable(['project']:string, node_id:string, dedup_key:string, _v:datetime, input:string, result_summary:string, target:string, _deleted:bool)[]),
    (tool_invocations_text | project ['project'], node_id, dedup_key, _v, input, result_summary, target,
                                    _deleted=column_ifexists('_deleted', false))
    | where all_nodes or node_id == requested_node
    | where dedup_key in (calls | project dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, dedup_key
    | where not(coalesce(_deleted, false))
    | project ['project'], node_id, fact_key=dedup_key, retained_input=input, retained_summary=result_summary, retained_target=target;
calls
| join kind=leftouter text_rows on ['project'], node_id, fact_key
| extend target=coalesce(retained_target, column_ifexists('target', '')),
         result_summary=coalesce(retained_summary, column_ifexists('result_summary', '')),
         input=coalesce(retained_input, column_ifexists('input', ''))
| where kind_filter != 'tests' or target contains 'test' or target contains 'jest' or target contains 'tox'
| extend input_signature=iff(kind_filter == 'loops' and isnotempty(input), hash_sha256(input), '')
| order by ts asc, node_id asc, id asc, fact_key asc
| take row_limit
| project node_id, session_id, agent_id, ts, tool_name, target, is_error, exit_code, duration_ms, confirm, confirm_wait_ms,
          result_summary, input_signature
