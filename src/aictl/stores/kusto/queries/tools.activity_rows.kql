declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real,
    requested_session:string = '', kind_filter:string, session_keys:dynamic = dynamic([]), after_row:string='', row_limit:long
);
let since_t = unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0));
let until_t = unixtime_seconds_todatetime(min_of(until, 32503680000.0));
let cursor_row = parse_json(after_row);
// Each kind returns only the text its reader uses: the result summary for failures, the input
// signature for loops. The other kinds return those columns empty. The loop finder compares the
// target and input of failing calls only, so loops return them for failing calls and leave them
// empty for the others.
let wants_summary = kind_filter == 'failures';
let wants_input = kind_filter == 'loops';
// A test run, as a superset of the board's rule (is_command_tool and shell_program.is_test_run):
// the tool name looks like a command tool, and the command without its quotes names a test
// runner (TEST_RUNNERS) as a whole word or as the last part of a path, or a program of
// TEST_SUBCOMMANDS followed by the word `test`. The board applies the exact rule to the calls
// this returns; test_board_api's superset test checks this against shell_program.
let command_tool = (name:string) {
    name matches regex @"(?i)bash|shell|terminal|powershell|exec_?command|run_?command|execute_?command"
};
let names_runner = (t:string) {
    replace_regex(tolower(t), @"['""]", '') matches regex @"(^|[\s;&|()/\\])((pytest|vitest|jest|tox|ctest|unittest|mocha|playwright|nox)(\.(exe|cmd|bat|com|ps1))?|(npm|pnpm|yarn|bun|go|cargo|make|dotnet|mvn|gradle|gradlew|deno|swift|mix)(\.(exe|cmd|bat|com|ps1))?(?:[\s()]|<<-?\s*[a-z_][\w-]*)+test)($|[\s;&|()<>\\])"
};
// tool_invocations_current holds the current row of each call per hour of its time (event_hour). A call
// whose time moved across an hour has a row in each hour: the hours one either side of the range are
// read too, and only the calls with two rows are reduced to the newest (docs/storage-schema.md). The
// range is applied to the stored datetime; times are read as epoch seconds and flags as 0/1 after it.
let current_rows = tool_invocations_current
    | where all_nodes or node_id == requested_node
    | where event_hour between (bin(since_t, 1h) - 1h .. until_t + 1h);
let crossed = current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let current_calls = materialize(
    union (current_rows | where dedup_key !in (crossed)),
        (current_rows | where dedup_key in (crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | where ts between (since_t .. until_t)
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error), fact_key=dedup_key
);
let eligible = (t:real, n:string, s:string, name:string, error:long, confirmation:string) {
    t between (since .. until) and isnotempty(s)
    and (isempty(requested_session) or s == requested_session)
    and (array_length(session_keys) == 0 or strcat(strlen(n), ':', n, s) in (session_keys))
    and case(kind_filter == 'confirms', isnotempty(confirmation),
             kind_filter == 'pending', confirmation == 'pending',
             kind_filter == 'failures', error == 1 and not(name startswith_cs 'permission:'),
             kind_filter == 'loops', not(name startswith_cs 'permission:'),
             kind_filter == 'tests', command_tool(name),
             false)
};
let retained = () { union isfuzzy=true
    (datatable(['project']:string, node_id:string, dedup_key:string, _v:datetime, input:string, result_summary:string, target:string, _deleted:bool)[]),
    (tool_invocations_text | project ['project'], node_id, dedup_key, _v, input, result_summary, target,
                                    _deleted=column_ifexists('_deleted', false))
    | where all_nodes or node_id == requested_node
};
// A test run has a test-like target in some version, in the call or in its retained text.
let text_tests = retained() | where kind_filter == 'tests' and names_runner(target)
    | distinct dedup_key;
// The current calls the kind selects; a test run names a test runner in its target or retained text.
let calls = materialize(current_calls
    | where eligible(ts,node_id,session_id,tool_name,is_error,confirm)
    | extend inline_test=kind_filter == 'tests' and names_runner(target)
    | where kind_filter != 'tests' or inline_test or fact_key in (text_tests)
    | project ['project'], node_id, fact_key, _v, id, ts, session_id, agent_id, tool_name, is_error, exit_code,
              duration_ms, confirm, confirm_wait_ms, inline_test, dedup_key, inline_target=target
);
let call_text = () { retained() | where dedup_key in (calls | project dedup_key) };
let test_targets = call_text()
    | where kind_filter == 'tests'
    | extend has_target=isnotempty(target), is_test=names_runner(target)
    | summarize arg_max(_v, _deleted, has_target, is_test) by ['project'], node_id, dedup_key
    | where not(coalesce(_deleted, false))
    | project ['project'], node_id, fact_key=dedup_key, has_target, is_test;
// The loop finder (find_loops) reads the calls of one agent in order. A loop is made of failing
// calls (an error, or a nonzero exit) and edits; any other call ends it, and so does a run of
// such calls: of each run only its first call is returned. The edit test is a superset of the
// board's is_edit_tool, so a call the board does not read as an edit is still returned. Of a run
// of edits that succeed, the finder uses only the first (where the loop starts): a plain edit,
// one whose name is a plain word that is surely not a server tool, is returned only when the
// call before it is not one.
let streamed = union
    (calls | where kind_filter != 'loops'),
    (calls | where kind_filter == 'loops'
        | extend agent_part=iff(isempty(agent_id) or agent_id == session_id, '', agent_id),
                 failing=coalesce(is_error, 0) != 0 or (isnotnull(exit_code) and exit_code != 0),
                 edit=tool_name matches regex @"(?i)edit|write|patch|replace|create_?file|insert|^create$"
        | extend relevant=failing or edit,
                 plain_edit=edit and not(failing) and tool_name matches regex @"^[A-Za-z0-9_]+$"
                     and not(tool_name startswith_cs 'mcp_')
        | sort by node_id asc, session_id asc, agent_part asc, ts asc, id asc nulls first, fact_key asc, ['project'] asc
        | extend stream_start=row_number(1, prev(node_id) != node_id or prev(session_id) != session_id
                                            or prev(agent_part) != agent_part) == 1
        | extend keep=stream_start or (relevant and not(plain_edit and prev(plain_edit))) or (not(relevant) and prev(relevant))
        | where keep
        | project-away agent_part, failing, edit, relevant, plain_edit, stream_start, keep);
let page = materialize(streamed
    | lookup kind=leftouter test_targets on ['project'], node_id, fact_key
    | where kind_filter != 'tests' or iff(has_target, is_test, inline_test)
    | where isempty(after_row) or case(
        ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
        node_id != tostring(cursor_row[1]), strcmp(node_id,tostring(cursor_row[1])) > 0,
        isnull(id) != isnull(cursor_row[2]), isnotnull(id),
        id != tolong(cursor_row[2]), id > tolong(cursor_row[2]),
        fact_key != tostring(cursor_row[3]), strcmp(fact_key,tostring(cursor_row[3])) > 0,
        strcmp(['project'],tostring(cursor_row[4])) > 0)
    | sort by ts asc,node_id asc,id asc nulls first,fact_key asc,['project'] asc
    | take row_limit
    | project-away has_target, is_test, inline_test, dedup_key);
let text_keys = page
    | where not(wants_input) or coalesce(is_error, 0) != 0 or (isnotnull(exit_code) and exit_code != 0)
    | project fact_key;
// The retained text of the calls on the page (read by their keys, not through calls: a join of the page
// with a statement over calls exceeded Kusto's 64 MB limit on a 100,000-call week).
let text_rows = retained()
    | where dedup_key in (text_keys)
    | project ['project'], node_id, dedup_key, _v, _deleted, target,
              input=iff(wants_input, input, ''), result_summary=iff(wants_summary, result_summary, '')
    | summarize arg_max(_v, _deleted, input, result_summary, target) by ['project'], node_id, dedup_key
    | where not(coalesce(_deleted, false))
    | project ['project'], node_id, fact_key=dedup_key,
              retained_signature=iff(kind_filter == 'loops' and isnotempty(input), hash_sha256(input), ''),
              retained_summary=result_summary, retained_target=target;
page
| join kind=leftouter text_rows on ['project'], node_id, fact_key
// A call outside text_keys (a loop call that did not fail) returns no target, as text_keys says.
| extend with_text=not(wants_input) or coalesce(is_error, 0) != 0 or (isnotnull(exit_code) and exit_code != 0)
| extend target=coalesce(retained_target, iff(with_text, inline_target, '')), result_summary=coalesce(retained_summary, ''),
         input_signature=coalesce(retained_signature, '')
| order by ts asc,node_id asc,id asc nulls first,fact_key asc,['project'] asc
| project node_id, session_id, agent_id, ts, tool_name, target, is_error, exit_code, duration_ms, confirm, confirm_wait_ms,
          result_summary, input_signature, _page_cursor=tostring(pack_array(ts,node_id,id,fact_key,['project']))
