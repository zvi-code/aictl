declare query_parameters(all_nodes:bool = true, requested_node:string = '', row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let data_quality_status_secs = data_quality_status | extend updated_at = (updated_at - datetime(1970-01-01)) / 1s, last_ok_at = (last_ok_at - datetime(1970-01-01)) / 1s;
data_quality_status_secs
| where all_nodes or node_id == requested_node
| summarize arg_max(_v, *) by ['project'], node_id, component, source
| where not(coalesce(column_ifexists('_deleted', false), false))
| order by updated_at desc, component asc, source asc, node_id asc, ['project'] asc
| take row_limit
| project component, source, kind, status, severity, message, updated_at, last_ok_at, count, detail=tostring(detail)
