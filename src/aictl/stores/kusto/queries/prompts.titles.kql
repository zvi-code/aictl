declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', session_keys:dynamic, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let session_prompts_secs = session_prompts | extend ts = (ts - datetime(1970-01-01)) / 1s;
session_prompts_secs
| where all_nodes or node_id == requested_node
| where strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
| extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
| summarize arg_max(_v, *) by ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false)) and isnotempty(text)
| summarize arg_min(ts, text) by node_id, session_id, agent_id
| order by node_id asc, session_id asc, agent_id asc
| take row_limit
| project node_id, session_id, agent_id, text
