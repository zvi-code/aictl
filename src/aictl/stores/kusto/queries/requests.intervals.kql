declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_model:string = '', intervals:dynamic, row_limit:long
);
// The requests table has a column requested_model, which hides a parameter of that name in its pipeline.
let wanted_model = requested_model;
let bounds = materialize(
    print bounds_row=intervals
    | mv-expand bounds_row
    | project node_id=tostring(bounds_row[0]), session_id=tostring(bounds_row[1]),
              start_ts=toreal(bounds_row[2]), next_ts=toreal(bounds_row[3])
);
requests
| where all_nodes or node_id == requested_node
| extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
| summarize arg_max(_v, *) by ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false))
| where isempty(wanted_model) or model == wanted_model
| join kind=inner bounds on node_id, session_id
| where ts >= start_ts and ts < next_ts
| summarize end_ts=max(ts + duration_ms / 1000.0),
            tokens=sum(input_tokens + output_tokens + cache_read_tokens + cache_creation_tokens)
        by node_id, session_id, start_ts
| order by node_id asc, session_id asc, start_ts asc
| take row_limit
