declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, grid:long,
    requested_session:string = '', session_keys:dynamic = dynamic([]), row_limit:long
);
// requests_current holds the current row of each call per hour of its time (event_hour). A call
// whose time moved across an hour has a row in each hour: the hours one either side of the range are
// read too, and only the calls with two rows are reduced to the newest (docs/storage-schema.md).
let current_rows = requests_current
    | where all_nodes or node_id == requested_node
    | where event_hour between (bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h .. unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h);
let crossed = current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
union (current_rows | where dedup_key !in (crossed)),
    (current_rows | where dedup_key in (crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
| where not(coalesce(_deleted, false))
| extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error)
| where ts between (since .. until) and isnotempty(session_id)
| where isempty(requested_session) or session_id == requested_session
| where array_length(session_keys) == 0 or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
| extend g=min_of(grid - 1, tolong((ts - since) / ((until - since) / grid)))
// A call stored with no cost has none that can be known (its source lacks what a price needs): it is
// a cell of its own, so its tokens are never priced at read time like a stored zero is.
| extend cost_known=isnotnull(cost_usd)
| summarize arg_max(ts, tool, project_path), calls=count(),
            input_tokens=sum(input_tokens), output_tokens=sum(output_tokens),
            cache_read_tokens=sum(cache_read_tokens), cache_creation_tokens=sum(cache_creation_tokens),
            errors=countif(is_error != 0), first_ts=min(ts), last_ts=max(ts), last_error=maxif(ts, is_error != 0),
            duration_count=countif(duration_ms > 0), max_duration=max(duration_ms), ttft_count=countif(ttft_ms > 0),
            max_ttft=max(ttft_ms), prices=countif(isnotnull(cost_usd)), sum_cost=sum(cost_usd)
        by node_id, session_id, agent_id, model, g, cost_known
| extend cost_usd=iff(prices == 0, real(null), sum_cost)
| project-away ts, prices, sum_cost
| order by node_id asc, session_id asc, agent_id asc, model asc, g asc, cost_known desc
| take row_limit
