declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, grid:long,
    requested_session:string = '', session_keys:dynamic = dynamic([]), row_limit:long
);
let wanted = (t:real, n:string, s:string) {
    t between (since .. until) and isnotempty(s)
    and (isempty(requested_session) or s == requested_session)
    and (array_length(session_keys) == 0 or strcat(strlen(n), ':', n, s) in (session_keys))
};
let versions = requests
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key);
// A request's newest version is in the window only if one of its versions is. The keys of the
// window are read first, so the cost follows the window and not the size of the table.
let keys = versions | where wanted(ts, node_id, session_id) | distinct ['project'], node_id, fact_key;
versions
| join kind=inner keys on ['project'], node_id, fact_key
| project-away ['project1'], node_id1, fact_key1
| summarize arg_max(_v, *) by ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false))
| where wanted(ts, node_id, session_id)
| extend g=min_of(grid - 1, tolong((ts - since) / ((until - since) / grid)))
| summarize arg_max(ts, tool, project_path), calls=count(),
            input_tokens=sum(input_tokens), output_tokens=sum(output_tokens),
            cache_read_tokens=sum(cache_read_tokens), cache_creation_tokens=sum(cache_creation_tokens),
            errors=countif(is_error != 0), first_ts=min(ts), last_ts=max(ts), last_error=maxif(ts, is_error != 0),
            duration_count=countif(duration_ms > 0), max_duration=max(duration_ms), ttft_count=countif(ttft_ms > 0),
            max_ttft=max(ttft_ms), prices=countif(isnotnull(cost_usd)), sum_cost=sum(cost_usd)
        by node_id, session_id, agent_id, model, g
| extend cost_usd=iff(prices == 0, real(null), sum_cost)
| project-away ts, prices, sum_cost
| order by node_id asc, session_id asc, agent_id asc, model asc, g asc
| take row_limit
