declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_session:string, requested_agent:string = '', row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// requests_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let requests_current_rows = requests_current
    | where session_id == requested_session;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
// session_prompts_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let session_prompts_current_rows = session_prompts_current
    | where session_id == requested_session;
let session_prompts_crossed = session_prompts_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let session_prompts_secs = union (session_prompts_current_rows | where dedup_key !in (session_prompts_crossed)),
        (session_prompts_current_rows | where dedup_key in (session_prompts_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let tool_invocations_current_rows = tool_invocations_current
    | where session_id == requested_session;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let facts = materialize(
    union (session_prompts_secs | extend fact_table='session_prompts'),
          (requests_secs | extend fact_table='requests'),
          (tool_invocations_secs | extend fact_table='tool_invocations')
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by fact_table, ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | extend prompt=fact_table == 'session_prompts', call=fact_table == 'requests'
    | where (prompt and agent_id == requested_agent)
        or (not(prompt) and (isempty(requested_agent) or agent_id == requested_agent))
    | where fact_table != 'tool_invocations' or not(tool_name startswith_cs 'permission:')
    | project ts, id, fact_key, prompt, call, agent_id, text, model, input_tokens, output_tokens, cache_read_tokens,
              cache_creation_tokens, cost_usd, duration_ms
);
let has_prompts = toscalar(facts | summarize countif(prompt)) > 0;
let turn_facts = materialize(
    facts
    | extend anchor=prompt or (not(has_prompts) and call)
    | order by ts asc, anchor desc, id asc, fact_key asc
    | extend turn=row_cumsum(toint(anchor))
    | where turn > 0
);
let models = turn_facts
    | where call
    | summarize calls=count(), first_ts=min(ts) by turn, model
    | order by turn asc, calls desc, first_ts asc, model asc
    | serialize
    | where turn != prev(turn, 1, long(0))
    | project turn, model;
turn_facts
| summarize ts=minif(ts, anchor), text=take_anyif(text, anchor), anchor_model=take_anyif(model, anchor),
            anchor_i=take_anyif(input_tokens, anchor), anchor_o=take_anyif(output_tokens, anchor),
            anchor_cr=take_anyif(cache_read_tokens, anchor), anchor_cw=take_anyif(cache_creation_tokens, anchor),
            anchor_cost=take_anyif(cost_usd, anchor), anchor_ms=take_anyif(duration_ms, anchor),
            tools=countif(not(prompt) and not(call)), calls=countif(call),
            input_tokens=sumif(input_tokens, call), output_tokens=sumif(output_tokens, call),
            cache_read_tokens=sumif(cache_read_tokens, call), cache_creation_tokens=sumif(cache_creation_tokens, call),
            priced=countif(call and cost_usd != 0), cost_usd=sumif(cost_usd, call),
            timed=countif(call and duration_ms != 0), reply_ms=sumif(duration_ms, call),
            subagent_calls=countif(call and isnotempty(agent_id) and isempty(requested_agent)) by turn
| join kind=leftouter models on turn
| order by turn desc
| take row_limit
| project ts, tools, text=coalesce(text, ''), model=iff(has_prompts, model, anchor_model), calls,
          input_tokens=iff(has_prompts, iff(calls == 0, long(null), input_tokens), anchor_i),
          output_tokens=iff(has_prompts, iff(calls == 0, long(null), output_tokens), anchor_o),
          cache_read_tokens=iff(has_prompts, iff(calls == 0, long(null), cache_read_tokens), anchor_cr),
          cache_creation_tokens=iff(has_prompts, iff(calls == 0, long(null), cache_creation_tokens), anchor_cw),
          cost_usd=iff(has_prompts, iff(priced == 0, real(null), cost_usd), anchor_cost),
          reply_ms=iff(has_prompts, iff(timed == 0, real(null), toreal(reply_ms)), toreal(anchor_ms)),
          subagent_calls=iff(has_prompts, subagent_calls, tolong(0))
