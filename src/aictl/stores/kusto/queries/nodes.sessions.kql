declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    since:real, until:real, node_limit:long, session_limit:long, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let sessions_secs = sessions | extend started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s;
let current = materialize(
    sessions_secs
    | where all_nodes or node_id == requested_node
    | where isempty(requested_project) or ['project'] == requested_project
    | summarize arg_max(_v, *) by ['project'], node_id, session_id
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where started_at >= since and started_at < until
    | project node_id, session_id, tool, model, project_path, started_at, ended_at,
              request_count, input_tokens, output_tokens, cost_usd
);
let totals_by_node = materialize(
    current
    | summarize sessions=count(), requests=sum(request_count), total_input=sum(input_tokens),
                total_output=sum(output_tokens), total_cost=sum(cost_usd) by node_id
);
union
    (totals_by_node | sort by node_id asc | take node_limit
        | project row_type='node', node_id, sessions, requests, input_tokens=total_input,
                  output_tokens=total_output, cost_usd=total_cost),
    (totals_by_node | summarize sessions=sum(sessions), requests=sum(requests), input_tokens=sum(total_input),
                                output_tokens=sum(total_output), cost_usd=sum(total_cost)
        | extend row_type='total'),
    (current | sort by started_at desc, node_id asc, session_id asc | take session_limit | extend row_type='session')
| order by row_type asc, started_at desc, node_id asc, session_id asc
| take row_limit
