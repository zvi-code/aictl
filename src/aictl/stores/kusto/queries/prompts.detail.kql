declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_session:string,
    prompt_ts:real, open_end:real, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// requests_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let requests_current_rows = requests_current
    | where session_id == requested_session;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
// session_prompts_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let session_prompts_current_rows = session_prompts_current
    | where session_id == requested_session;
let session_prompts_crossed = session_prompts_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let session_prompts_secs = union (session_prompts_current_rows | where dedup_key !in (session_prompts_crossed)),
        (session_prompts_current_rows | where dedup_key in (session_prompts_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let tool_invocations_current_rows = tool_invocations_current
    | where session_id == requested_session;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let facts = materialize(
    union (session_prompts_secs | extend fact_table='session_prompts'),
          (requests_secs | extend fact_table='requests'),
          (tool_invocations_secs | extend fact_table='tool_invocations')
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by fact_table, ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
);
let prompt = materialize(
    facts
    | where fact_table == 'session_prompts' and ts between ((prompt_ts - 0.001) .. (prompt_ts + 0.001))
    | extend distance=abs(ts - prompt_ts)
    | top 1 by distance asc
    | project node_id, start=ts, text, prompt_file, project_path
);
let start_ts = toscalar(prompt | project start);
let node = toscalar(prompt | project node_id);
let end_ts = coalesce(toscalar(
    facts | where fact_table == 'session_prompts' and node_id == node and isempty(agent_id) and ts > start_ts
    | summarize min(ts)
), open_end);
let usage = facts
    | where node_id == node and ts >= start_ts and ts < end_ts
    | summarize calls=countif(fact_table == 'requests'),
                subagent_calls=countif(fact_table == 'requests' and isnotempty(agent_id)),
                input_tokens=sumif(input_tokens, fact_table == 'requests'),
                output_tokens=sumif(output_tokens, fact_table == 'requests'),
                cache_read_tokens=sumif(cache_read_tokens, fact_table == 'requests'),
                cache_creation_tokens=sumif(cache_creation_tokens, fact_table == 'requests'),
                timed=countif(fact_table == 'requests' and duration_ms != 0),
                reply_ms=sumif(duration_ms, fact_table == 'requests' and duration_ms != 0),
                cost_usd=sumif(cost_usd, fact_table == 'requests'),
                tool_calls=countif(fact_table == 'tool_invocations' and not(tool_name startswith_cs 'permission:'))
    | extend join_key=1;
prompt
| extend join_key=1
| join kind=inner usage on join_key
| take row_limit
| project text, prompt_file, project_path,
    input_tokens=iff(calls == 0, long(null), input_tokens), output_tokens=iff(calls == 0, long(null), output_tokens),
    cache_read_tokens=iff(calls == 0, long(null), cache_read_tokens),
    cache_creation_tokens=iff(calls == 0, long(null), cache_creation_tokens),
    reply_ms=iff(timed == 0, real(null), toreal(reply_ms)), cost_usd, calls,
    subagent_calls=iff(calls == 0, long(null), subagent_calls), tool_calls
