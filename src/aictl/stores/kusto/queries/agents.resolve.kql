declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    requested_agent:string, requested_session:string = '', row_limit:long
);
// An agent id is unique only within its session (a resumed session copies its subagents):
// every session that holds the id is returned, and the caller reports more than one as ambiguous.
union
    (agents
    | where agent_id == requested_agent and (all_nodes or node_id == requested_node)
    | where isempty(requested_project) or ['project'] == requested_project
    | where isempty(requested_session) or session_id == requested_session
    | summarize arg_max(_v, *) by ['project'], node_id, session_id, agent_id
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | project node_id, agent_id, session_id, priority=0, ts=started_at),
    (requests
    | where all_nodes or node_id == requested_node
    | where isempty(requested_project) or ['project'] == requested_project
    | where isempty(requested_session) or session_id == requested_session
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where agent_id == requested_agent
    | project node_id, agent_id, session_id, priority=1, ts)
| where isnotempty(session_id) and session_id != requested_agent
| summarize ts=min(ts) by priority, node_id, agent_id, session_id
| order by priority asc, ts asc, node_id asc, session_id asc
| take row_limit
| project node_id, agent_id, session_id, priority
