declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    requested_agent:string, requested_session:string = '', row_limit:long
);
// An agent id is unique only within its session (a resumed session copies its subagents):
// every session that holds the id is returned, and the caller reports more than one as ambiguous.
// The main agent of a session is named by the session id and matches no row here.
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let agents_secs = agents | extend is_sidechain = tolong(is_sidechain), started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, completed = tolong(completed), observed_at = (observed_at - datetime(1970-01-01)) / 1s;
// requests_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let requests_current_rows = requests_current;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
union
    (agents_secs
    | where agent_id == requested_agent and (all_nodes or node_id == requested_node)
    | where isempty(requested_project) or ['project'] == requested_project
    | where isempty(requested_session) or session_id == requested_session
    | summarize arg_max(_v, *) by ['project'], node_id, session_id, agent_id
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | project node_id, agent_id, session_id, priority=0, ts=started_at),
    // agent_id and session_id are in a request tombstone's scope: filtering on them before the
    // versions are reduced keeps its tombstones, and reads only the requests of this agent id.
    (requests_secs
    | where agent_id == requested_agent and session_id != requested_agent
    | where all_nodes or node_id == requested_node
    | where isempty(requested_project) or ['project'] == requested_project
    | where isempty(requested_session) or session_id == requested_session
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where agent_id == requested_agent
    | project node_id, agent_id, session_id, priority=1, ts)
| where isnotempty(session_id) and session_id != requested_agent
| summarize ts=min(ts) by priority, node_id, agent_id, session_id
| order by priority asc, ts asc, node_id asc, session_id asc
| take row_limit
| project node_id, agent_id, session_id, priority
