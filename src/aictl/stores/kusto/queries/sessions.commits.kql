declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '', requested_session:string, after_row:string='',
    row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let session_commits_secs = session_commits | extend ts = (ts - datetime(1970-01-01)) / 1s;
let cursor_row = parse_json(after_row);
session_commits_secs
| where session_id == requested_session and (all_nodes or node_id == requested_node)
    and (isempty(requested_project) or ['project'] == requested_project)
| summarize arg_max(_v, *) by ['project'], node_id, session_id, sha
| where not(coalesce(column_ifexists('_deleted', false), false))
| where isempty(after_row) or case(
    isnull(ts) != isnull(cursor_row[0]), isnotnull(ts),
    ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
    sha != tostring(cursor_row[1]), strcmp(sha,tostring(cursor_row[1])) > 0,
    node_id != tostring(cursor_row[2]), strcmp(node_id,tostring(cursor_row[2])) > 0,
    strcmp(['project'],tostring(cursor_row[3])) > 0)
| order by ts asc nulls first, sha asc, node_id asc, ['project'] asc
| take row_limit
| project sha, author_name, author_email, ts, subject, _page_cursor=tostring(pack_array(ts,sha,node_id,['project']))
