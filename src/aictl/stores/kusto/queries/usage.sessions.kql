declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    since:real = real(null), until:real = real(null), requested_session:string = '',
    without_requests:bool = false, session_keys:dynamic = dynamic([]), row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// requests_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). A session of the range may have made its calls
// before the range, so every hour is read: the sessions with a call are left out whenever they made it.
let requests_current_rows = requests_current
    | where without_requests and (all_nodes or node_id == requested_node);
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let session_usage_secs = session_usage | extend started_at = (started_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s, updated_at = (updated_at - datetime(1970-01-01)) / 1s;
let usage = session_usage_secs
    | where all_nodes or node_id == requested_node
    | where isempty(requested_project) or ['project'] == requested_project
    | where isempty(requested_session) or session_id == requested_session
    | where array_length(session_keys) == 0 or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | summarize arg_max(_v, *) by ['project'], node_id, session_id
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where (isnull(since) or last_activity_at >= since) and (isnull(until) or coalesce(started_at, 0.0) <= until);
let request_sessions = requests_secs
    | where without_requests and (all_nodes or node_id == requested_node)
    | where isempty(requested_project) or ['project'] == requested_project
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false))
    | where isnotempty(session_id) and (isempty(requested_session) or session_id == requested_session)
    | where array_length(session_keys) == 0 or strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | summarize by node_id, session_id;
usage
| join kind=leftanti request_sessions on node_id, session_id
| order by node_id asc, session_id asc, ['project'] asc
| take row_limit
| project-away _v, ['project']
