declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    requested_session:string, requested_agent:string = '',
    since:real = real(null), until:real = real(null), row_limit:long
);
// requests_current holds the current row of each call per hour of its time (event_hour). A call
// whose time moved across an hour has a row in each hour: the hours one either side of the range are
// read too, and only the calls with two rows are reduced to the newest (docs/storage-schema.md).
let current_rows = requests_current
    | where all_nodes or node_id == requested_node
    | where isempty(requested_project) or ['project'] == requested_project
    | where session_id == requested_session and (isempty(requested_agent) or agent_id == requested_agent)
    | where isnull(since) or event_hour >= bin(unixtime_seconds_todatetime(since), 1h) - 1h
    | where isnull(until) or event_hour <= unixtime_seconds_todatetime(until) + 1h;
let crossed = current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
union (current_rows | where dedup_key !in (crossed)),
    (current_rows | where dedup_key in (crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
| where not(coalesce(_deleted, false))
| extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error)
| where (isnull(since) or ts >= since) and (isnull(until) or ts <= until)
// A call stored with no cost has none that can be known: a row of its own, never priced at read time.
| extend cost_known=isnotnull(cost_usd)
| summarize calls=count(), input_tokens=sum(input_tokens), output_tokens=sum(output_tokens),
            cache_read_tokens=sum(cache_read_tokens), cache_creation_tokens=sum(cache_creation_tokens),
            last_ts=max(ts), priced=countif(isnotnull(cost_usd)), sum_cost=sum(cost_usd) by model, cost_known
| where isnotempty(model) or input_tokens + output_tokens + cache_read_tokens + cache_creation_tokens > 0
| project model, calls, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens,
          last_ts, cost_usd=iff(priced == 0, real(null), sum_cost), cost_known
| order by model asc, cost_known desc
| take row_limit
