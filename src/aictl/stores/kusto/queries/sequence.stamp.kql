declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_session:string,
    since:real, until:real, row_limit:long);
union
    (requests | project session_id,node_id,ts,_v),
    (tool_invocations | project session_id,node_id,ts,_v),
    (session_prompts | project session_id,node_id,ts,_v),
    (events | project session_id,node_id,ts,_v),
    (context_events | project session_id,node_id,ts,_v),
    (session_steps | project session_id,node_id,ts,_v),
    (session_step_text | project session_id,node_id,ts,_v),
    (copilot_session_messages | project session_id,node_id,ts,_v),
    (cursor_session_messages | project session_id,node_id,ts,_v),
    (vscode_chat_messages | project session_id,node_id,ts,_v),
    (agents | project session_id,node_id,ts=coalesce(ended_at,started_at),_v),
    (sessions | project session_id,node_id,ts=coalesce(ended_at,started_at),_v)
| where session_id == requested_session and (all_nodes or node_id == requested_node)
| where isnull(ts) or ts < until
| summarize versions=count(), newest=max(_v), in_window=countif(ts >= since)
| take row_limit
