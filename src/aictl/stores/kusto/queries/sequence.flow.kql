declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_session:string,
    since:real, until:real, keep_text:bool=true, text_floor:real=0.0, after_row:string='', row_limit:long);
let cursor_row = parse_json(after_row);
let session_rows = materialize(sessions
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | summarize arg_max(_v, *) by ['project'], node_id, session_id
    | where not(column_ifexists('_deleted', false)));
// Records are read in the requested time window before their versions are reduced: ts is in the
// tombstone scope of requests and tool calls, and the other windowed tables have no tombstones.
let calls = materialize(requests
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | where ts >= since and ts < until
    | extend key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, key
    | where not(column_ifexists('_deleted', false)));
let prompts = materialize(session_prompts
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | where ts >= since and ts < until
    | extend key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, key
    | where not(column_ifexists('_deleted', false)));
let flow_tools = materialize(tool_invocations
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | where ts >= since and ts < until
    | extend key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, key
    | where not(column_ifexists('_deleted', false)));
let tool_text = union isfuzzy=true
    (datatable(['project']:string,node_id:string,dedup_key:string,_v:datetime,input:string,result_summary:string,target:string,_deleted:bool)[]),
    (tool_invocations_text | project ['project'], node_id, dedup_key, _v, input, result_summary, target, _deleted=column_ifexists('_deleted',false))
    | where keep_text and (all_nodes or node_id == requested_node)
    | where dedup_key in (flow_tools | where ts >= max_of(since,text_floor) and ts < until | project dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, dedup_key
    | where not(_deleted)
    | project ['project'], node_id, key=dedup_key, retained_input=input, retained_result=result_summary, retained_target=target;
let steps = materialize(session_steps
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | where ts >= since and ts < until
    | summarize arg_max(_v, *) by ['project'], node_id, step_key
    | where not(column_ifexists('_deleted', false)));
let step_text = session_step_text
    | where keep_text and session_id == requested_session and (all_nodes or node_id == requested_node)
    | where ts >= since and ts < until
    | summarize arg_max(_v, *) by ['project'], node_id, step_key
    | where not(column_ifexists('_deleted', false)) and ts >= text_floor
    | project ['project'], node_id, session_id, step_key, retained=text;
let message_rows = union
    (copilot_session_messages | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | where ts >= since and ts < until
        | summarize arg_max(_v, *) by ['project'], node_id, source_table, source_row_id
        | where not(column_ifexists('_deleted',false))
        | project ['project'], node_id, ts, role, content, model='', key=strcat('copilot:',source_table,':',source_row_id)),
    (vscode_chat_messages | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | summarize arg_max(_v, *) by ['project'], node_id, session_id, source_file, source_row_id
        | where not(column_ifexists('_deleted',false))
        | project ['project'], node_id, ts, role, content, model, key=strcat('vscode:',source_file,':',source_row_id)),
    (cursor_session_messages | where session_id == requested_session and (all_nodes or node_id == requested_node)
        | where ts >= since and ts < until
        | extend key=iff(isempty(source_key),tostring(source_row_id),source_key)
        | summarize arg_max(_v, *) by ['project'], node_id, key
        | where not(column_ifexists('_deleted',false))
        | project ['project'], node_id, ts, role, content, model='', key=strcat('cursor:',key));
let agent_rows = materialize(agents
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | summarize arg_max(_v, *) by ['project'], node_id, session_id, agent_id
    | where not(column_ifexists('_deleted',false)) and agent_id != requested_session
    | where (started_at >= since and started_at < until) or (ended_at >= since and ended_at < until));
let tasks = union isfuzzy=true
    (datatable(['project']:string,node_id:string,session_id:string,agent_id:string,_v:datetime,ts:real,task:string,_deleted:bool)[]),
    (agents_text | project ['project'], node_id, session_id=column_ifexists('session_id',''), agent_id, _v, ts, task,
        _deleted=column_ifexists('_deleted',false))
    | where keep_text and (all_nodes or node_id == requested_node) and session_id == requested_session
    | where agent_id in (agent_rows | project agent_id)
    | summarize arg_max(_v, *) by ['project'], node_id, session_id, agent_id
    | where not(_deleted) and ts >= text_floor
    | project ['project'], node_id, session_id, agent_id, retained_task=task;
let session_events = materialize(context_events
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | where ts < until
    | extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, key
    | where not(column_ifexists('_deleted',false)));
let known_events = events
    | where session_id == requested_session and (all_nodes or node_id == requested_node)
    | extend key=iff(isempty(source_key),strcat(ts,':',kind,':',seq),source_key), deleted=column_ifexists('_deleted',false)
    | summarize arg_max(_v, deleted) by ['project'],node_id,key
    | where not(deleted)
    | take 1;
// The session's tool is that of its first model call, wherever the window starts: read only for
// a session whose row names no tool.
let session_tool = toscalar(session_rows | where isnotempty(tool) | count) > 0;
let first_tool = requests
    | where not(session_tool)
    | where session_id == requested_session and (all_nodes or node_id == requested_node) and isnotempty(tool)
    | extend key=iff(isempty(dedup_key), tostring(id), dedup_key), deleted=column_ifexists('_deleted', false)
    | summarize arg_max(_v, ts, tool, deleted) by ['project'], node_id, key
    | where not(deleted)
    | top 1 by ts asc;
union
    (session_rows | top 1 by _v desc
        | project row_type='session', values=pack_array(tool,project_path,started_at,ended_at)),
    (first_tool | project row_type='tool', values=pack_array(tool)),
    (union (session_rows | project present=1), (first_tool | project present=1), (calls | project present=1),
           (flow_tools | project present=1),
           (prompts | project present=1), (known_events | project present=1)
        | take 1 | project row_type='known', values=pack_array(true)),
    (prompts | where ts >= since and ts < until
        | project row_type='prompt', ts, key, node_id, ['project'], values=pack_array(ts,agent_id,iff(keep_text and ts >= text_floor,text,''))),
    (message_rows | where ts >= since and ts < until and isnotempty(content) and role in ('user','assistant')
        | project row_type=role, ts, key, node_id, ['project'], values=pack_array(ts,iff(keep_text and ts >= text_floor,content,''),model)),
    // The person's and agents' messages, and the replies that have text (Copilot CLI assistant.message;
    // for a session with no events file, the turns of its session-store.db).
    (steps | where (source in ('user.message','copilot-session-store') and role == 'user' and kind in ('message','agent_prompt'))
            or (source in ('assistant.message','copilot-session-store') and kind == 'message' and role == 'assistant')
        | join kind=leftouter step_text on ['project'], node_id, session_id, step_key
        | where role == 'user' or isnotempty(retained) or text_status in ('truncated','expired','withheld')
        | project row_type='native', ts, key=step_key, source_order, node_id, ['project'],
                  values=pack_array(ts,kind,role,step_key,turn_id,text_status,retained,agent_id)),
    // What the agent said it achieved when it ended a task (Copilot CLI session.task_complete summary).
    (session_digests
        | where keep_text and session_id == requested_session and (all_nodes or node_id == requested_node) and kind == 'task_summary'
        | summarize arg_max(_v, *) by ['project'], node_id, session_id, agent_id, kind, seq
        | where not(column_ifexists('_deleted', false)) and ts >= since and ts < until and ts >= text_floor
        | project row_type='outcome', ts, key=strcat(agent_id, ':', tostring(seq)), node_id, ['project'],
                  values=pack_array(ts,text,agent_id)),
    (calls | where ts >= since and ts < until
        | project row_type='call', ts, key, node_id, ['project'], values=pack_array(ts,agent_id,model,input_tokens,output_tokens,cache_read_tokens,
            cache_creation_tokens,cost_usd,duration_ms,ttft_ms,finish_reason,is_error,error_type,http_status,
            request_bytes,column_ifexists('thinking_chars',long(null)),column_ifexists('reasoning_tokens',long(null)))),
    (flow_tools | where ts >= since and ts < until and not(tool_name startswith_cs 'permission:')
        | join kind=leftouter tool_text on ['project'], node_id, key
        | project row_type='use', ts, key, node_id, ['project'], values=pack_array(ts,agent_id,tool_name,
            iff(keep_text and ts >= text_floor,coalesce(retained_target,column_ifexists('target','')),''),
            iff(keep_text and ts >= text_floor,coalesce(retained_input,column_ifexists('input','')),''),
            iff(keep_text and ts >= text_floor,coalesce(retained_result,column_ifexists('result_summary','')),''),
            duration_ms,is_error,exit_code,confirm,input_bytes,output_bytes,confirm_wait_ms,source_event_id)),
    (agent_rows | join kind=leftouter tasks on ['project'], node_id, session_id, agent_id
        | project row_type='agent', ts=started_at, key=agent_id, node_id, ['project'],
                  values=pack_array(agent_id,iff(keep_text,coalesce(retained_task,column_ifexists('task','')),''),model,started_at,ended_at,completed,
                                   parent_tool_use_id,description,status)),
    // A subagent's start and end as its session file reports them, with the totals of its end, and
    // the session's own resumes and shutdowns.
    (session_events | where kind in ('subagent_start','subagent_end','config.session_resume','session_shutdown')
            and ts >= since and ts < until
        | project row_type='lifecycle', ts, key, node_id, ['project'],
                  values=pack_array(ts,kind,agent_id,trigger,duration_ms,tool_call_id,detail)),
    (session_events | where kind == 'compaction' and ts < until
        | order by ts asc, key asc | serialize ordinal=row_number()
        | where ts >= since
        | project row_type='compaction', ts, key, node_id, ['project'], values=pack_array(ordinal,ts,agent_id,trigger,before_tokens,after_tokens,duration_ms)),
    (steps | where kind in ('session_command','context','skill','agent')
        | where not(kind == 'context' and source == 'session.compaction_complete' and phase == 'compaction_complete')
        | project row_type='step', ts, key=step_key, source_order, node_id, ['project'],
                  values=pack_array(ts,kind,name,phase,agent_id,turn_id,context_tokens,context_limit,before_tokens,after_tokens,estimated,source))
// Continue strictly after the last row of the previous page, in the sort order below.
| where isempty(after_row) or case(
    row_type != tostring(cursor_row[0]), strcmp(row_type,tostring(cursor_row[0])) > 0,
    isnull(ts) != isnull(cursor_row[1]), isnotnull(ts),
    ts != toreal(cursor_row[1]), ts > toreal(cursor_row[1]),
    isnull(source_order) != isnull(cursor_row[2]), isnull(source_order),
    source_order != tolong(cursor_row[2]), source_order > tolong(cursor_row[2]),
    key != tostring(cursor_row[3]), strcmp(key,tostring(cursor_row[3])) > 0,
    node_id != tostring(cursor_row[4]), strcmp(node_id,tostring(cursor_row[4])) > 0,
    strcmp(['project'],tostring(cursor_row[5])) > 0)
| order by row_type asc, ts asc nulls first, source_order asc nulls last, key asc, node_id asc, ['project'] asc
| take row_limit
| project row_type, values, _page_cursor=tostring(pack_array(row_type,ts,source_order,key,node_id,['project']))
