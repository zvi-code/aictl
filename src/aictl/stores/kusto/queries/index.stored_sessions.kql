// The sessions the store holds of a node, one row per session, for the Index screen's comparison of
// session files on disk with stored sessions. Pages by after_row.
declare query_parameters(all_nodes:bool=true, requested_node:string='', after_row:string='', row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let sessions_secs = sessions | extend started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s;
let cursor_row = parse_json(after_row);
sessions_secs
| where all_nodes or node_id == requested_node
| summarize arg_max(_v, *) by ['project'], node_id, session_id
| where not(coalesce(column_ifexists('_deleted', false), false))
| where isempty(after_row) or case(
    node_id != tostring(cursor_row[0]), strcmp(node_id, tostring(cursor_row[0])) > 0,
    session_id != tostring(cursor_row[1]), strcmp(session_id, tostring(cursor_row[1])) > 0,
    strcmp(['project'], tostring(cursor_row[2])) > 0)
| order by node_id asc, session_id asc, ['project'] asc
| take row_limit
| project node_id, session_id, tool, source, project_path, started_at, last_activity_at,
    _page_cursor=tostring(pack_array(node_id, session_id, ['project']))
