declare query_parameters(all_nodes:bool=true, requested_node:string='', since:real=0.0, until:real=1.0e20,
    requested_tool:string='', requested_path:string='', requested_paths:dynamic=dynamic([]),
    inventory_mode:string='all', project_path_key:string='', fold_project:bool=false, after_row:string='', row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let files_secs = files | extend mtime = (mtime - datetime(1970-01-01)) / 1s, first_seen = (first_seen - datetime(1970-01-01)) / 1s, last_read = (last_read - datetime(1970-01-01)) / 1s, last_changed = (last_changed - datetime(1970-01-01)) / 1s;
let folded = (p:string) { iff(fold_project, trim_end(@'/+', replace_string(tolower(p), '\\', '/')), trim_end(@'/+', p)) };
let cursor_row = parse_json(after_row);
files_secs
| where all_nodes or node_id == requested_node
| extend deleted=column_ifexists('_deleted',false)
| summarize arg_max(_v,deleted,tool,category,scope,size_bytes,tokens,lines,mtime,meta,last_changed)
    by ['project'],node_id,path
| where not(deleted)
// Memory files are counted when they exist; the time a scan saw a change does not decide that.
| where inventory_mode == 'memory' or isnull(last_changed) or last_changed between (since .. until)
| where isempty(requested_tool) or tool in (requested_tool,'')
| where array_length(requested_paths)==0 or path in (requested_paths)
| where inventory_mode != 'memory' or category contains 'memory' or category contains 'instruction'
| where isempty(project_path_key) or folded(['project']) == project_path_key
    or folded(path) startswith strcat(project_path_key,'/')
| where inventory_mode != 'session' or scope in ('global','user')
    or (isnotempty(requested_path) and (replace_string(path,@'\','/') =~ requested_path
       or replace_string(path,@'\','/') startswith strcat(requested_path,'/')))
// Null change times sort last. Use the complete versioned identity to break ties.
| where isempty(after_row) or case(
    isnull(last_changed) != isnull(cursor_row[0]), isnull(last_changed),
    last_changed != toreal(cursor_row[0]), last_changed < toreal(cursor_row[0]),
    node_id != tostring(cursor_row[1]), strcmp(node_id,tostring(cursor_row[1])) > 0,
    path != tostring(cursor_row[2]), strcmp(path,tostring(cursor_row[2])) > 0,
    strcmp(['project'],tostring(cursor_row[3])) > 0)
| order by last_changed desc nulls last,node_id asc,path asc,['project'] asc
| take row_limit
| project node_id,path,tool,category,scope,size_bytes,tokens,lines,mtime,meta,last_changed,
    _page_cursor=tostring(pack_array(last_changed,node_id,path,['project']))
