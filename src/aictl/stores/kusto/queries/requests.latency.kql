declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, grid:long,
    session_keys:dynamic, requested_model:string = '', row_limit:long
);
let wanted = (t:real, n:string, s:string, m:string, d:real, f:real) {
    t between (since .. until) and (d > 0 or f > 0)
    and (isempty(requested_model) or m == requested_model)
    and strcat(strlen(n), ':', n, s) in (session_keys)
};
// requests_current holds the current row of each call per hour of its time (event_hour). A call
// whose time moved across an hour has a row in each hour: the hours one either side of the range are
// read too, and only the calls with two rows are reduced to the newest (docs/storage-schema.md).
let current_rows = requests_current
    | where all_nodes or node_id == requested_node
    | where event_hour between (bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h .. unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h);
let crossed = current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
union (current_rows | where dedup_key !in (crossed)),
    (current_rows | where dedup_key in (crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
| where not(coalesce(_deleted, false))
| extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error)
| where wanted(ts, node_id, session_id, model, duration_ms, ttft_ms)
| extend g=min_of(grid - 1, tolong((ts - since) / ((until - since) / grid)))
| summarize durations=make_list_if(duration_ms, duration_ms > 0, 20000), firsts=make_list_if(ttft_ms, ttft_ms > 0, 20000),
            duration_count=countif(duration_ms > 0), first_count=countif(ttft_ms > 0)
        by node_id, session_id, model, g
| order by node_id asc, session_id asc, model asc, g asc
| take row_limit
