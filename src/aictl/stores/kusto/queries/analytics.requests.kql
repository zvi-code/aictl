declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real,
    restrict_tools:bool = false, requested_tools:dynamic = dynamic([]), page_size:long, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// requests_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let requests_current_rows = requests_current
    | where event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let sessions_secs = sessions | extend started_at = (started_at - datetime(1970-01-01)) / 1s, ended_at = (ended_at - datetime(1970-01-01)) / 1s, last_activity_at = (last_activity_at - datetime(1970-01-01)) / 1s;
let named_sessions = sessions_secs
    | where all_nodes or node_id == requested_node
    | summarize arg_max(_v, *) by node_id, ['project'], session_id
    | where not(coalesce(column_ifexists('_deleted', false), false)) and isnotempty(session_id)
    | summarize arg_max(_v, tool) by node_id, session_id
    | project node_id, session_id, session_tool=tool;
let calls = materialize(requests_secs
    | where all_nodes or node_id == requested_node
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by node_id, ['project'], fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false)) and ts between (since .. until)
    | project node_id, session_id, agent_id, tool, model, ts, duration_ms=coalesce(duration_ms, 0.0),
              input_tokens, output_tokens, cache_read_tokens, finish_reason, cost_usd, is_error
    | join kind=leftouter named_sessions on node_id, session_id
    | extend attributed=iff(tool in ('', 'any', 'unknown'), session_tool, tool));
let selected = materialize(calls | where not(restrict_tools) or attributed in (requested_tools));
let model_counts = selected | summarize count=count(), avg_ms=avg(duration_ms),
    input_tokens=sum(input_tokens), output_tokens=sum(output_tokens) by model;
let model_ranks = selected
    | project model, duration_ms
    | sort by model asc, duration_ms asc
    | extend rank=row_number(0, prev(model) != model);
union
    (calls | summarize hidden=countif(restrict_tools and attributed in ('', 'any', 'unknown')) | extend row_type='hidden'),
    (model_ranks | join kind=inner model_counts on model
        | summarize p50_ms=maxif(duration_ms, rank == count / 2),
                    p95_ms=maxif(duration_ms, rank == min_of(tolong(count * 0.95), count - 1)),
                    max_ms=max(duration_ms) by model, count, avg_ms, input_tokens, output_tokens
        | extend row_type='model'),
    (selected | top page_size by ts desc
              | project row_type='request', ts, duration_ms, input_tokens, output_tokens, cache_read_tokens,
                        model, session_id, agent_id, finish_reason, cost_usd, is_error)
| order by row_type asc, ts desc
| take row_limit
