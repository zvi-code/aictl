declare query_parameters(all_nodes:bool=true, requested_node:string='', since:real, until:real,
    calendar_starts:dynamic, calendar_days:dynamic, requested_tools:dynamic=dynamic([]),
    restrict_tools:bool=false, row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// requests_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let requests_current_rows = requests_current
    | where event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h;
let requests_crossed = requests_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let requests_secs = union (requests_current_rows | where dedup_key !in (requests_crossed)),
        (requests_current_rows | where dedup_key in (requests_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let calendar = print intervals=zip(calendar_days,array_slice(calendar_starts,0,-2),array_slice(calendar_starts,1,-1))
    | mv-expand interval=intervals
    | project day=tostring(interval[0]), day_start=toreal(interval[1]), day_end=toreal(interval[2]), join_key=1;
requests_secs
| where all_nodes or node_id == requested_node
| extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
| summarize arg_max(_v, *) by ['project'],node_id,key
| where not(column_ifexists('_deleted',false)) and ts >= since and ts < until
| where not(restrict_tools) or tool in (requested_tools)
| extend join_key=1
| lookup kind=inner calendar on join_key
| where ts >= day_start and ts < day_end
| summarize calls=count(), input=sum(input_tokens), output=sum(output_tokens), cache_read=sum(cache_read_tokens),
    cache_write=sum(cache_creation_tokens), stored=sumif(cost_usd,cost_usd>0),
    // A stored zero is priced at list price on read; a call stored with no cost has none that can be known.
    ri=sumif(input_tokens,cost_usd<=0), ro=sumif(output_tokens,cost_usd<=0),
    rcr=sumif(cache_read_tokens,cost_usd<=0), rcw=sumif(cache_creation_tokens,cost_usd<=0),
    unknown=sumif(input_tokens + output_tokens + cache_read_tokens + cache_creation_tokens,isnull(cost_usd)), last_ts=max(ts)
    by node_id,day,model,tool
| order by node_id asc,day asc,model asc,tool asc
| take row_limit
