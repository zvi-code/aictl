// The memory recalls of one session, oldest first: each memory or instruction file the tool loaded into
// the context (Claude Code; content_hash names the loaded text in file_blobs) and each memory or past-session
// search the agent called (Copilot; tool_call_id names the call). Pages by after_row.
declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_project:string='',
    requested_session:string, after_row:string='', row_limit:long);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let context_events_secs = context_events | extend ts = (ts - datetime(1970-01-01)) / 1s;
let cursor_row = parse_json(after_row);
context_events_secs
// context_events takes no delete rows, and a key's versions are one event of one session.
| where session_id == requested_session and (all_nodes or node_id == requested_node)
    and (isempty(requested_project) or ['project'] == requested_project)
| extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
| summarize arg_max(_v, *) by ['project'],node_id,key
| where ['kind'] == 'memory_recall'
| where isempty(after_row) or case(
    ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
    key != tostring(cursor_row[1]), strcmp(key,tostring(cursor_row[1])) > 0,
    node_id != tostring(cursor_row[2]), strcmp(node_id,tostring(cursor_row[2])) > 0,
    strcmp(['project'],tostring(cursor_row[3])) > 0)
| order by ts asc, key asc, node_id asc, ['project'] asc
| take row_limit
| project node_id, ts, key, agent_id, tool, ['trigger'], path, content_hash, tool_call_id, prompt_id, turn_index, detail=tostring(detail),
    _page_cursor=tostring(pack_array(ts,key,node_id,['project']))
