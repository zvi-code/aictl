declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', since:real, until:real, session_keys:dynamic,
    search_text:string, extended:bool = false, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
// file_write_events_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let file_write_events_current_rows = file_write_events_current
    | where event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h;
let file_write_events_crossed = file_write_events_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let file_write_events_secs = union (file_write_events_current_rows | where dedup_key !in (file_write_events_crossed)),
        (file_write_events_current_rows | where dedup_key in (file_write_events_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
// session_prompts_current holds the current row of each key per hour of its time (event_hour); only the keys with
// two rows are reduced again (docs/storage-schema.md). Every hour is read: not every use here keeps only
// the rows of the range.
let session_prompts_current_rows = session_prompts_current;
let session_prompts_crossed = session_prompts_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let session_prompts_secs = union (session_prompts_current_rows | where dedup_key !in (session_prompts_crossed)),
        (session_prompts_current_rows | where dedup_key in (session_prompts_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | extend ts = (ts - datetime(1970-01-01)) / 1s;
// tool_invocations_current holds the current row of each key per hour of its time (event_hour); the hours one
// either side of the range are read, and only the keys with two rows are reduced again (docs/storage-schema.md).
let tool_invocations_current_rows = tool_invocations_current
    | where event_hour >= bin(unixtime_seconds_todatetime(min_of(max_of(since, 0.0), 32503680000.0)), 1h) - 1h
    | where event_hour <= unixtime_seconds_todatetime(min_of(until, 32503680000.0)) + 1h;
let tool_invocations_crossed = tool_invocations_current_rows | summarize copies=count() by dedup_key | where copies > 1 | project dedup_key;
let tool_invocations_secs = union (tool_invocations_current_rows | where dedup_key !in (tool_invocations_crossed)),
        (tool_invocations_current_rows | where dedup_key in (tool_invocations_crossed) | summarize arg_max(_v, *) by ['project'], node_id, dedup_key)
    | where not(coalesce(_deleted, false))
    | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let facts = materialize(
    union (session_prompts_secs | extend fact_table='session_prompts'),
          (tool_invocations_secs | extend fact_table='tool_invocations'),
          (file_write_events_secs | extend fact_table='file_write_events')
    | where all_nodes or node_id == requested_node
    | where strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
    | extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
    | summarize arg_max(_v, *) by fact_table, ['project'], node_id, fact_key
    | where not(coalesce(column_ifexists('_deleted', false), false)) and ts between (since .. until)
);
let retained = union isfuzzy=true
    (datatable(['project']:string, node_id:string, dedup_key:string, _v:datetime, target:string, _deleted:bool)[]),
    (tool_invocations_text | project ['project'], node_id, dedup_key, _v, target, _deleted=column_ifexists('_deleted', false))
    | where all_nodes or node_id == requested_node
    | where dedup_key in (facts | where fact_table == 'tool_invocations' | project dedup_key)
    | summarize arg_max(_v, *) by ['project'], node_id, dedup_key
    | where not(coalesce(_deleted, false))
    | project ['project'], node_id, fact_key=dedup_key, retained_target=target;
facts
| join kind=leftouter retained on ['project'], node_id, fact_key
| where (fact_table == 'session_prompts' and text contains search_text)
     or (fact_table == 'tool_invocations' and
         (coalesce(retained_target, column_ifexists('target', '')) contains search_text or (extended and tool_name contains search_text)))
     or (extended and fact_table == 'file_write_events' and path contains search_text)
| distinct node_id, session_id
| order by node_id asc, session_id asc
| take row_limit
