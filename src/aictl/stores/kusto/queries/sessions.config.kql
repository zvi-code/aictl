// The configuration a session ran under, oldest first: the launch flags of its process, the values
// at start and resume, and every change of model, effort, mode, permissions, managed override,
// feature flags, assignment context, subagent configuration and working folder (context_events
// kinds config.*). setting names what a row sets; previous_value and new_value are the values
// the tool reported ("" when it reported none), previous_effort and new_effort the reasoning
// effort a model change or start reported. detail keeps every field as reported.
declare query_parameters(all_nodes:bool=true, requested_node:string='', requested_project:string='',
    requested_session:string, after_row:string='', row_limit:long);
let cursor_row = parse_json(after_row);
context_events
// context_events takes no delete rows, and a key's versions are one event of one session.
| where session_id == requested_session and (all_nodes or node_id == requested_node)
    and (isempty(requested_project) or ['project'] == requested_project)
    and ['kind'] startswith 'config.'
| extend key=iff(isempty(dedup_key),tostring(id),dedup_key)
| summarize arg_max(_v, *) by ['project'],node_id,key
| extend fields=parse_json(iff(isempty(detail),'{}',detail))
// The launch flags as one line: --flag=value, or --flag for a switch.
| mv-apply flag=iff(['kind'] == 'config.launch_flags', fields['flags'], dynamic([])) to typeof(dynamic) on (
    summarize flag_text=strcat_array(make_list(iff(isempty(tostring(flag['value'])), tostring(flag['flag']),
        strcat(tostring(flag['flag']), '=', tostring(flag['value'])))), ' '))
| extend setting=case(
        ['kind'] in ('config.session_start','config.session_resume','config.model_change','config.managed_override',
                     'config.subagent_configured'), 'model',
        ['kind'] == 'config.mode_change', 'mode',
        ['kind'] == 'config.permissions_change' and isnotempty(tostring(fields['allowAllPermissionMode'])), 'allow_all',
        ['kind'] == 'config.permissions_change', 'permission_mode',
        ['kind'] == 'config.context_changed', 'cwd',
        substring(['kind'], 7)),
    previous_value=case(
        ['kind'] == 'config.model_change', tostring(fields['previousModel']),
        ['kind'] == 'config.mode_change', tostring(fields['previousMode']),
        ['kind'] == 'config.permissions_change' and isnotempty(tostring(fields['allowAllPermissionMode'])),
            tostring(fields['previousAllowAllPermissionMode']),
        ['kind'] == 'config.permissions_change', tostring(fields['previousMode']),
        ['kind'] == 'config.feature_flags', tostring(fields['previous_hash']),
        ''),
    new_value=case(
        ['kind'] == 'config.launch_flags', flag_text,
        ['kind'] in ('config.session_start','config.session_resume'), tostring(fields['selectedModel']),
        ['kind'] == 'config.model_change', tostring(fields['newModel']),
        ['kind'] == 'config.managed_override', tostring(fields['message']),
        ['kind'] == 'config.mode_change', tostring(fields['newMode']),
        ['kind'] == 'config.permissions_change' and isnotempty(tostring(fields['allowAllPermissionMode'])),
            tostring(fields['allowAllPermissionMode']),
        ['kind'] == 'config.permissions_change', tostring(fields['mode']),
        ['kind'] in ('config.feature_flags','config.assignment_context'), tostring(fields['hash']),
        ['kind'] == 'config.subagent_configured', tostring(fields['model']),
        ['kind'] == 'config.context_changed', tostring(fields['cwd']),
        ''),
    previous_effort=tostring(fields['previousReasoningEffort']),
    new_effort=tostring(fields['reasoningEffort'])
| where isempty(after_row) or case(
    ts != toreal(cursor_row[0]), ts > toreal(cursor_row[0]),
    key != tostring(cursor_row[1]), strcmp(key,tostring(cursor_row[1])) > 0,
    node_id != tostring(cursor_row[2]), strcmp(node_id,tostring(cursor_row[2])) > 0,
    strcmp(['project'],tostring(cursor_row[3])) > 0)
| order by ts asc, key asc, node_id asc, ['project'] asc
| take row_limit
| project node_id, ts, key, ['kind'], agent_id, tool, source=['trigger'], setting, previous_value, new_value,
    previous_effort, new_effort, turn_index, prompt_id, detail,
    _page_cursor=tostring(pack_array(ts,key,node_id,['project']))
