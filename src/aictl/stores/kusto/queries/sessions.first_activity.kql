declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', requested_project:string = '',
    requested_session:string, row_limit:long
);
// Stored times are UTC datetimes and flags bools; this view reads them as epoch seconds and 0/1.
let requests_secs = requests | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
let session_prompts_secs = session_prompts | extend ts = (ts - datetime(1970-01-01)) / 1s;
let tool_invocations_secs = tool_invocations | extend ts = (ts - datetime(1970-01-01)) / 1s, is_error = tolong(is_error);
union (requests_secs | extend table_name='requests'),
      (tool_invocations_secs | extend table_name='tool_invocations'),
      (session_prompts_secs | extend table_name='session_prompts')
| where all_nodes or node_id == requested_node
| where isempty(requested_project) or ['project'] == requested_project
| extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
| summarize arg_max(_v, *) by table_name, ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false))
| where session_id == requested_session
| summarize first_ts=min(ts)
| take row_limit
