declare query_parameters(
    all_nodes:bool = true, requested_node:string = '', session_keys:dynamic, row_limit:long
);
requests
| where all_nodes or node_id == requested_node
| extend fact_key=iff(isempty(dedup_key), tostring(id), dedup_key)
| summarize arg_max(_v, *) by ['project'], node_id, fact_key
| where not(coalesce(column_ifexists('_deleted', false), false))
| where isempty(agent_id) and strcat(strlen(node_id), ':', node_id, session_id) in (session_keys)
| summarize arg_max(ts, finish_reason) by node_id, session_id
| where finish_reason in ('end_turn', 'stop', 'stop_sequence')
| order by node_id asc, session_id asc
| take row_limit
| project node_id, session_id
